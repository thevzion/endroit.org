---
const runtimes = [
	{ id: 'codex', label: 'Codex', status: 'Available today' },
	{ id: 'claude', label: 'Claude Code', status: 'Available today' },
	{ id: 'hermes', label: 'Hermes', status: 'Ecosystem example' },
	{ id: 'cursor', label: 'Cursor', status: 'Ecosystem example' },
	{ id: 'openclaw', label: 'OpenClaw', status: 'Ecosystem example' },
];

const targets = [
	{ id: 'application', label: 'Application' },
	{ id: 'api', label: 'API' },
	{ id: 'documentation', label: 'Documentation' },
	{ id: 'repository', label: 'Repository' },
];
---

<section class="environment-layer" id="environment-layer" aria-labelledby="environment-layer-title">
	<div class="shell">
		<header class="layer-intro">
			<div>
				<p class="eyebrow">Where Hairness sits</p>
				<h2 id="environment-layer-title">The missing environment layer.</h2>
			</div>
			<div>
				<p>
					Agent Runtimes wake, reason and execute. Hairness gives their durable
					work an owned environment to enter.
				</p>
				<strong>Keep the runtime. Own what matters.</strong>
			</div>
		</header>

		<div class="system-map" data-environment-map data-flow="ready">
			<header class="map-head">
				<div>
					<p>Environment topology</p>
					<h3>One Home. Any execution surface.</h3>
				</div>
				<div class="analogy" aria-label="Mental model">
					<span>Browser</span><i aria-hidden="true">→</i><b>Web application</b>
					<span>Agent Runtime</span><i aria-hidden="true">→</i><b>Owned Home</b>
				</div>
			</header>

			<div class="human-rail">
				<p><small>Owner &amp; steward</small><strong>Human</strong></p>
				<ul aria-label="Direct source tools">
					<li>Editor</li><li>Git</li><li>Terminal</li>
				</ul>
				<span>direction · judgment · curation</span>
			</div>

			<div class="topology">
				<section class="runtime-zone" aria-labelledby="runtime-layer-title">
					<header>
						<p>01 · Execution</p>
						<h4 id="runtime-layer-title">Agent Runtimes</h4>
						<span>Wake, reason and execute.</span>
					</header>
					<div class="selector" role="group" aria-label="Select an Agent Runtime">
						{
							runtimes.map(({ id, label, status }, index) => (
								<button
									type="button"
									data-runtime={id}
									data-label={label}
									aria-pressed={index === 0 ? 'true' : 'false'}
								>
									<i aria-hidden="true">{label.slice(0, 2).toUpperCase()}</i>
									<b>{label}</b>
									<small>{status}</small>
								</button>
							))
						}
					</div>
					<footer>
						<small>Separate model supply</small>
						<span>OpenAI · Anthropic · Gemini</span>
					</footer>
				</section>

				<div class="gate front-door" aria-label="Front Door">
					<div class="signal" aria-hidden="true"><i></i><b></b></div>
					<p>02 · Entry</p>
					<strong>Front Door</strong>
					<span>Bridge · Floor Plan · Console</span>
				</div>

				<section class="home-zone" aria-labelledby="home-layer-title">
					<header>
						<div>
							<p>03 · Owned environment</p>
							<h4 id="home-layer-title">Hairness Home</h4>
						</div>
						<span>source-owned<br />runtime-neutral</span>
					</header>
					<div class="home-body">
						<ol aria-label="Home areas">
							<li><small>01</small><b>Desk</b><span>collaborator continuity</span></li>
							<li><small>02</small><b>Assets</b><span>products for work</span></li>
							<li><small>03</small><b>Artifacts</b><span>products of work</span></li>
						</ol>
						<div class="curation-loop" aria-label="Human curation loop">
							<small>Curation loop</small>
							<p><b>Assets</b><i>→</i><b>Work</b><i>→</i><b>Artifacts</b></p>
							<span>human curation ↗ better Assets</span>
						</div>
					</div>
					<footer>
						<p><small>Owner</small> Individual or organization</p>
						<p><small>Persists</small> Sources, contracts and lineage</p>
					</footer>
				</section>

				<div class="gate binding" aria-label="Binding">
					<div class="signal" aria-hidden="true"><i></i><b></b></div>
					<p>04 · Route</p>
					<strong>Binding</strong>
					<span>local · explicit · checked</span>
				</div>

				<section class="target-zone" aria-labelledby="target-layer-title">
					<header>
						<p>05 · Product truth</p>
						<h4 id="target-layer-title">Targets</h4>
						<span>Stay independent.</span>
					</header>
					<div class="selector target-selector" role="group" aria-label="Select a Target">
						{
							targets.map(({ id, label }, index) => (
								<button
									type="button"
									data-target={id}
									data-label={label}
									aria-pressed={index === 0 ? 'true' : 'false'}
								>
									<b>{label}</b>
									<small>Target</small>
								</button>
							))
						}
					</div>
					<div class="access-plane">
						<small>Access plane</small>
						<b>MCP</b>
						<span>GitHub · Slack · Notion</span>
						<p>External systems keep their data and authorization.</p>
					</div>
				</section>
			</div>

			<div class="asset-rail">
				<p>
					<small>Methods &amp; tools</small>
					<span>GSD · Spec Kit · BMAD · Superpowers · Ponytail · stop-slop</span>
				</p>
				<i aria-hidden="true"></i>
				<p><b>Home Assets</b><span>adapt · install · compose</span></p>
				<small>Examples of organizable material—not announced integrations.</small>
			</div>

			<footer class="map-foot">
				<p role="status" aria-live="polite" data-route-status>
					Codex entered through the Front Door. The Home persisted. Application
					is the active Target.
				</p>
				<button type="button" data-replay>
					<span aria-hidden="true">↻</span> Replay route
				</button>
			</footer>
		</div>

		<footer class="layer-thesis">
			<p>
				<span>Hairness 0.5</span> qualifies Codex and Claude today. Other runtime
				names show ecosystem placement, not shipped integrations.
			</p>
			<strong>The runtime executes. The Home owns. The Target delivers.</strong>
		</footer>
	</div>
</section>

<script>
	for (const map of document.querySelectorAll<HTMLElement>('[data-environment-map]')) {
		const status = map.querySelector<HTMLElement>('[data-route-status]');
		const runtimeButtons = [...map.querySelectorAll<HTMLButtonElement>('[data-runtime]')];
		const targetButtons = [...map.querySelectorAll<HTMLButtonElement>('[data-target]')];
		const replay = map.querySelector<HTMLButtonElement>('[data-replay]');

		const selected = (buttons: HTMLButtonElement[]) =>
			buttons.find((button) => button.getAttribute('aria-pressed') === 'true')
				?.dataset.label ?? '';

		const announce = () => {
			if (!status) return;
			map.dataset.flow = 'moving';
			status.textContent = `${selected(runtimeButtons)} entered through the Front Door. The Home persisted. ${selected(targetButtons)} is the active Target.`;
			window.setTimeout(() => {
				map.dataset.flow = 'ready';
			}, 900);
		};

		const select = (buttons: HTMLButtonElement[], active: HTMLButtonElement) => {
			buttons.forEach((button) =>
				button.setAttribute('aria-pressed', String(button === active)),
			);
			announce();
		};

		runtimeButtons.forEach((button) =>
			button.addEventListener('click', () => select(runtimeButtons, button)),
		);
		targetButtons.forEach((button) =>
			button.addEventListener('click', () => select(targetButtons, button)),
		);
		replay?.addEventListener('click', announce);
	}
</script>

<style>
	.environment-layer {
		--layer-bg: #070909;
		--layer-panel: #0c0f0f;
		--layer-raised: #101414;
		--layer-ink: #f0ede4;
		--layer-muted: #a0a49f;
		--layer-faint: #929792;
		--layer-line: rgba(235, 231, 219, 0.14);
		--layer-line-strong: rgba(235, 231, 219, 0.26);
		--layer-copper: #e09260;
		--layer-copper-hot: #ffad75;
		--layer-copper-soft: rgba(224, 146, 96, 0.12);
		--layer-green: #acd3b8;
		padding-block: clamp(5rem, 10vw, 9rem);
		border-top: 1px solid var(--line);
		background: var(--layer-bg);
		color: var(--layer-ink);
	}

	.layer-intro {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(19rem, 0.65fr);
		gap: clamp(2rem, 8vw, 7rem);
		align-items: end;
		margin-bottom: clamp(3rem, 6vw, 5rem);
	}

	.layer-intro h2 {
		max-width: 760px;
		margin: 0;
	}

	.layer-intro .eyebrow {
		color: var(--layer-copper-hot);
	}

	.layer-intro > div:last-child {
		padding-left: 1.5rem;
		border-left: 1px solid var(--layer-line-strong);
	}

	.layer-intro > div:last-child p {
		color: #c4c4bd;
		font-size: 1.05rem;
	}

	.layer-intro > div:last-child strong {
		color: var(--layer-muted);
		font: 650 0.67rem "SFMono-Regular", Consolas, monospace;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.system-map {
		overflow: hidden;
		border: 1px solid var(--layer-line-strong);
		background: rgba(9, 11, 11, 0.94);
		box-shadow: 0 32px 100px rgba(0, 0, 0, 0.45);
	}

	.map-head {
		display: flex;
		gap: 2rem;
		align-items: center;
		justify-content: space-between;
		min-height: 8rem;
		padding: 1.5rem 1.7rem;
		border-bottom: 1px solid var(--layer-line);
		background: linear-gradient(90deg, rgba(224, 146, 96, 0.07), transparent 35%), var(--layer-panel);
	}

	.map-head p,
	.map-head h3,
	.human-rail p {
		margin: 0;
	}

	.map-head p,
	.runtime-zone header p,
	.home-zone header p,
	.target-zone header p,
	.gate p,
	small {
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 0.58rem;
		font-weight: 700;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.map-head p,
	.runtime-zone header p,
	.home-zone header p,
	.target-zone header p,
	.gate p {
		color: var(--layer-copper-hot);
	}

	.map-head h3 {
		margin-top: 0.4rem;
		font-size: clamp(1.5rem, 3vw, 2.35rem);
		font-weight: 620;
		letter-spacing: -0.035em;
	}

	.analogy {
		display: grid;
		grid-template-columns: auto auto auto;
		gap: 0.25rem 0.7rem;
		min-width: 24rem;
		padding: 0.9rem 1rem;
		border-left: 1px solid var(--layer-line-strong);
		font: 0.66rem "SFMono-Regular", Consolas, monospace;
	}

	.analogy span {
		color: var(--layer-muted);
	}

	.analogy i {
		color: var(--layer-copper);
		font-style: normal;
	}

	.analogy b {
		font-weight: 650;
	}

	.human-rail {
		position: relative;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 1rem;
		align-items: center;
		min-height: 5.4rem;
		padding: 1rem 1.7rem;
		border-bottom: 1px solid var(--layer-line);
	}

	.human-rail::after {
		position: absolute;
		z-index: 2;
		bottom: -2.6rem;
		left: 50%;
		width: 1px;
		height: 2.6rem;
		background: linear-gradient(var(--layer-copper), rgba(224, 146, 96, 0.15));
		content: "";
	}

	.human-rail p {
		display: flex;
		gap: 0.8rem;
		align-items: baseline;
	}

	.human-rail small,
	.asset-rail small {
		color: var(--layer-faint);
	}

	.human-rail strong {
		font-size: 1.05rem;
	}

	.human-rail ul {
		display: flex;
		gap: 0.45rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.human-rail li {
		padding: 0.3rem 0.55rem;
		border: 1px solid var(--layer-line);
		color: #c7cac5;
		font: 0.62rem "SFMono-Regular", Consolas, monospace;
	}

	.human-rail > span {
		justify-self: end;
		color: var(--layer-green);
		font: 0.62rem "SFMono-Regular", Consolas, monospace;
	}

	.topology {
		display: grid;
		grid-template-columns: minmax(10.5rem, 0.82fr) minmax(4.4rem, 0.25fr) minmax(24rem, 1.7fr) minmax(4.4rem, 0.25fr) minmax(10.5rem, 0.82fr);
		min-height: 35rem;
	}

	.runtime-zone,
	.home-zone,
	.target-zone,
	.gate {
		min-width: 0;
	}

	.runtime-zone,
	.target-zone {
		display: flex;
		flex-direction: column;
		padding: 1.35rem;
		background: rgba(255, 255, 255, 0.012);
	}

	.runtime-zone header,
	.target-zone header {
		min-height: 6rem;
	}

	.runtime-zone h4,
	.target-zone h4,
	.home-zone h4 {
		margin: 0.35rem 0;
		font-size: 1.2rem;
	}

	.runtime-zone header span,
	.target-zone header span,
	.home-zone header > span {
		color: var(--layer-muted);
		font-size: 0.72rem;
	}

	.selector {
		border-top: 1px solid var(--layer-line);
	}

	.selector button {
		display: grid;
		grid-template-columns: 2rem 1fr auto;
		gap: 0.65rem;
		align-items: center;
		width: 100%;
		min-height: 3.45rem;
		padding: 0.55rem 0;
		border: 0;
		border-bottom: 1px solid var(--layer-line);
		background: transparent;
		color: inherit;
		cursor: pointer;
		font: inherit;
		text-align: left;
	}

	.selector button i {
		display: grid;
		place-items: center;
		width: 1.8rem;
		height: 1.8rem;
		border: 1px solid var(--layer-line-strong);
		color: var(--layer-muted);
		font: 0.56rem "SFMono-Regular", Consolas, monospace;
		font-style: normal;
	}

	.selector button b {
		font-size: 0.78rem;
	}

	.selector button small {
		max-width: 5.5rem;
		color: var(--layer-faint);
		font-size: 0.56rem;
		line-height: 1.25;
		text-align: right;
	}

	.selector button[aria-pressed="true"] i {
		border-color: var(--layer-copper);
		background: var(--layer-copper-soft);
		color: var(--layer-copper-hot);
		box-shadow: 0 0 24px rgba(224, 146, 96, 0.15);
	}

	.selector button:focus-visible,
	.map-foot button:focus-visible {
		outline: 2px solid var(--layer-copper-hot);
		outline-offset: 3px;
	}

	.runtime-zone footer {
		display: grid;
		gap: 0.4rem;
		margin-top: auto;
		padding-top: 1rem;
		border-top: 1px solid var(--layer-line);
	}

	.runtime-zone footer small,
	.access-plane small {
		color: var(--layer-faint);
	}

	.runtime-zone footer span {
		color: var(--layer-muted);
		font: 0.58rem/1.6 "SFMono-Regular", Consolas, monospace;
	}

	.gate {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 1rem 0.5rem;
		border-inline: 1px solid var(--layer-line);
		background: repeating-linear-gradient(135deg, transparent 0 8px, rgba(255, 255, 255, 0.018) 8px 9px);
		text-align: center;
	}

	.gate p,
	.gate strong,
	.gate > span {
		writing-mode: vertical-rl;
	}

	.gate p {
		margin: 0 0 0.75rem;
	}

	.gate strong {
		font: 650 0.65rem "SFMono-Regular", Consolas, monospace;
	}

	.gate > span {
		margin-top: 0.8rem;
		color: var(--layer-faint);
		font: 0.53rem/1.5 "SFMono-Regular", Consolas, monospace;
	}

	.signal {
		position: absolute;
		top: 50%;
		left: -1px;
		width: calc(100% + 2px);
		height: 1px;
		background: var(--layer-line-strong);
	}

	.signal i {
		position: absolute;
		top: -3px;
		left: -3px;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--layer-copper-hot);
		box-shadow: 0 0 18px var(--layer-copper);
	}

	.signal b {
		position: absolute;
		top: -4px;
		right: -1px;
		width: 8px;
		height: 8px;
		border-top: 1px solid var(--layer-copper);
		border-right: 1px solid var(--layer-copper);
		transform: rotate(45deg);
	}

	[data-flow="moving"] .front-door .signal i {
		animation: layer-pass-through 0.45s ease-in forwards;
	}

	[data-flow="moving"] .binding .signal i {
		animation: layer-pass-through 0.45s 0.42s ease-out forwards;
	}

	.home-zone {
		display: flex;
		flex-direction: column;
		padding: 1.35rem 1.6rem;
		background: linear-gradient(rgba(224, 146, 96, 0.025), transparent 35%), var(--layer-raised);
		box-shadow: inset 0 0 0 1px rgba(224, 146, 96, 0.08);
	}

	.home-zone header {
		display: flex;
		justify-content: space-between;
		min-height: 6rem;
	}

	.home-zone header > span {
		text-align: right;
	}

	.home-body {
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		gap: 1.2rem;
		flex: 1;
	}

	.home-body ol {
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--layer-line);
		list-style: none;
	}

	.home-body li {
		display: grid;
		grid-template-areas: "number title" ". copy";
		grid-template-columns: 2rem 1fr;
		gap: 0.15rem 0.6rem;
		min-height: 5rem;
		align-content: center;
		border-bottom: 1px solid var(--layer-line);
	}

	.home-body li small {
		grid-area: number;
		color: var(--layer-copper);
	}

	.home-body li b {
		grid-area: title;
		font-size: 0.8rem;
	}

	.home-body li span {
		grid-area: copy;
		color: var(--layer-muted);
		font-size: 0.65rem;
	}

	.curation-loop {
		align-self: center;
		padding: 1rem;
		border-block: 1px solid var(--layer-line);
		background: rgba(0, 0, 0, 0.1);
	}

	.curation-loop > small {
		color: var(--layer-faint);
	}

	.curation-loop p {
		display: flex;
		gap: 0.45rem;
		align-items: center;
		margin: 0.8rem 0;
		font-size: 0.68rem;
	}

	.curation-loop p i {
		color: var(--layer-copper);
		font-style: normal;
	}

	.curation-loop span {
		color: var(--layer-green);
		font: 0.58rem/1.5 "SFMono-Regular", Consolas, monospace;
	}

	.home-zone footer {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 1.4rem;
		padding-top: 1rem;
		border-top: 1px solid var(--layer-line);
	}

	.home-zone footer p {
		margin: 0;
		color: var(--layer-muted);
		font-size: 0.62rem;
	}

	.home-zone footer small {
		display: block;
		margin-bottom: 0.25rem;
		color: var(--layer-faint);
	}

	.target-selector button {
		grid-template-columns: 1fr auto;
	}

	.target-selector button[aria-pressed="true"] {
		padding-inline: 0.6rem;
		background: var(--layer-copper-soft);
	}

	.access-plane {
		display: grid;
		gap: 0.5rem;
		margin-top: auto;
		padding-top: 1rem;
		border-top: 1px solid var(--layer-line);
	}

	.access-plane b {
		color: var(--layer-copper-hot);
		font: 0.75rem "SFMono-Regular", Consolas, monospace;
	}

	.access-plane span {
		color: var(--layer-muted);
		font: 0.58rem "SFMono-Regular", Consolas, monospace;
	}

	.access-plane p {
		margin: 0;
		color: var(--layer-faint);
		font-size: 0.6rem;
	}

	.asset-rail {
		display: grid;
		grid-template-columns: 1fr 8rem auto 1fr;
		gap: 1rem;
		align-items: center;
		min-height: 6rem;
		padding: 1rem 1.7rem;
		border-top: 1px solid var(--layer-line);
	}

	.asset-rail p {
		display: grid;
		gap: 0.4rem;
		margin: 0;
	}

	.asset-rail p > span {
		color: var(--layer-muted);
		font: 0.62rem/1.5 "SFMono-Regular", Consolas, monospace;
	}

	.asset-rail > i {
		height: 1px;
		background: linear-gradient(90deg, var(--layer-line), var(--layer-copper));
	}

	.asset-rail > small {
		justify-self: end;
		max-width: 16rem;
		color: var(--layer-faint);
		line-height: 1.5;
		text-align: right;
	}

	.map-foot {
		display: flex;
		gap: 1rem;
		align-items: center;
		justify-content: space-between;
		min-height: 4.5rem;
		padding: 0.8rem 1.7rem;
		border-top: 1px solid var(--layer-line);
		background: var(--layer-panel);
	}

	.map-foot p {
		margin: 0;
		color: var(--layer-green);
		font: 0.62rem/1.5 "SFMono-Regular", Consolas, monospace;
	}

	.map-foot p::before {
		margin-right: 0.55rem;
		color: var(--layer-copper-hot);
		content: "●";
