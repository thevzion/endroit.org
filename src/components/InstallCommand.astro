---
const commands = [
	'npx --yes @endroit/cli@latest create my-home',
	'cd my-home',
	'codex',
];
const command = commands.join('\n');
---

<div class="install-command">
	<div class="flex items-center justify-between gap-4 border-b border-white/10 px-5 py-4 sm:px-6">
		<div class="flex items-center gap-3">
			<span class="flex gap-1.5" aria-hidden="true">
				<i class="size-2.5 rounded-full bg-[#e47862]"></i>
				<i class="size-2.5 rounded-full bg-[#d9a64f]"></i>
				<i class="size-2.5 rounded-full bg-valid"></i>
			</span>
			<span class="font-mono text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-paper/70">
				Create one Home
			</span>
		</div>
		<button
			class="copy-command"
			type="button"
			data-copy-command={command}
			hidden
		>
			<svg aria-hidden="true" viewBox="0 0 20 20">
				<rect x="6.5" y="6.5" width="9" height="9" rx="1.5"></rect>
				<path d="M4.5 13.5h-1a1.5 1.5 0 0 1-1.5-1.5V3.5A1.5 1.5 0 0 1 3.5 2H12a1.5 1.5 0 0 1 1.5 1.5v1"></path>
			</svg>
			<span data-copy-label>Copy commands</span>
		</button>
	</div>

	<div class="overflow-x-auto px-5 py-6 sm:px-6">
		<ol class="grid min-w-[34rem] gap-3 font-mono text-sm text-paper-strong">
			{
				commands.map((line, index) => (
					<li class="grid grid-cols-[1.5rem_1rem_1fr] items-baseline gap-2">
						<span class="select-none text-right text-paper/65">{String(index + 1).padStart(2, '0')}</span>
						<span class="select-none text-copper-light" aria-hidden="true">$</span>
						<code>{line}</code>
					</li>
				))
			}
		</ol>
	</div>

	<div class="flex flex-col gap-2 border-t border-white/10 px-5 py-4 text-xs text-paper/50 sm:flex-row sm:items-center sm:justify-between sm:px-6">
		<p class="m-0">Use <code class="text-paper/80">claude</code> instead of <code class="text-paper/80">codex</code> if you prefer.</p>
		<p class="m-0 font-mono" role="status" aria-live="polite" data-copy-status></p>
	</div>
</div>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-command]')) {
		if (!navigator.clipboard) continue;

		button.hidden = false;
		button.dataset.supported = 'true';
		button.addEventListener('click', async () => {
			const command = button.dataset.copyCommand;
			const label = button.querySelector<HTMLElement>('[data-copy-label]');
			const status = button.closest('.install-command')?.querySelector<HTMLElement>('[data-copy-status]');
			if (!command || !label || !status) return;

			try {
				await navigator.clipboard.writeText(command);
				label.textContent = 'Copied';
				status.textContent = 'Commands copied to clipboard.';
				window.setTimeout(() => {
					label.textContent = 'Copy commands';
					status.textContent = '';
				}, 1800);
			} catch {
				status.textContent = 'Copy unavailable. Select the commands manually.';
			}
		});
	}
</script>
