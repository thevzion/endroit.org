---
const docsUrl = 'https://github.com/thevzion/hairness#readme';
const githubUrl = 'https://github.com/thevzion/hairness';
---

<header class="site-header">
	<div class="shell header-inner">
		<a class="brand" href="/" aria-label="Hairness home">
			<span class="brand-mark" aria-hidden="true"><i></i></span>
			<span>hairness</span>
		</a>
		<nav aria-label="Primary navigation">
			<a href="https://thevzion.com/home-first/">Home-first <span aria-hidden="true">↗</span></a>
			<a href="/homes/">Homes</a>
			<a href={docsUrl}>Docs <span aria-hidden="true">↗</span></a>
			<a href={githubUrl}>GitHub <span aria-hidden="true">↗</span></a>
		</nav>
		<a class="button button-small button-primary header-cta" href="/#create-home">Install</a>
	</div>
</header>
