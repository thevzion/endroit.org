	.fragment {
		position: absolute;
		z-index: 6;
		left: var(--tx);
		top: var(--ty);
		padding: 0.4rem 0.62rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--paper-strong);
		font-size: 0.62rem;
		font-weight: 850;
