---
import '../../../styles/global.css';

const createCommand = 'npx --yes @hairness/cli@latest create my-home';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex, nofollow" />
		<meta
			name="description"
			content="A local landing exploration for the Hairness Home-first paradigm."
		/>
		<title>Hairness — Home-first landing exploration</title>
	</head>
	<body>
		<div class="lab-rail">
			<a href="/lab/">← Iterations</a>
			<span>002 · Home-first landing</span>
			<strong>Local only</strong>
		</div>

		<header class="site-nav">
			<a class="wordmark" href="#top" aria-label="Hairness home">
				<i aria-hidden="true"></i>
				hairness
			</a>
			<nav aria-label="Main navigation">
				<a href="#paradigm">Paradigm</a>
				<a href="#assets">Assets</a>
				<a href="#collaboration">Collaboration</a>
			</nav>
			<a class="nav-cta" href="#start">Create your Home</a>
		</header>

		<main id="top">
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">The Home-first framework for agentic work.</p>
					<h1>Your agentic work needs a <em>Home.</em></h1>
					<p class="hero-lede">
						Hairness turns scattered skills, agent definitions, methods and
						outputs into a source-owned environment for human-agent
						collaboration—across providers and repositories.
					</p>
					<div class="hero-actions">
						<a class="button button-primary" href="#start">Create your Home</a>
						<a class="button button-ghost" href="#paradigm">See the paradigm shift ↓</a>
					</div>
					<p class="proof">
						<span>Open source</span><i>·</i><span>Codex + Claude today</span
						><i>·</i><span>Hairness 0.5 alpha</span>
					</p>
				</div>

				<div class="hero-system" aria-label="A Home owns agentic Assets and continuity between providers and Targets.">
					<div class="orbit orbit-provider">
						<span>Codex</span>
						<span>Claude</span>
					</div>
					<div class="hero-home">
						<small>Source-owned environment</small>
						<strong>HOME</strong>
						<div>
							<span>Assets</span>
							<span>Desk</span>
							<span>Artifacts</span>
						</div>
					</div>
					<div class="orbit orbit-target">
						<span>Application</span>
						<span>API</span>
						<span>Docs</span>
					</div>
					<i class="hero-path path-in" aria-hidden="true"></i>
					<i class="hero-path path-out" aria-hidden="true"></i>
				</div>
			</section>

			<section class="manifesto">
				<p>
					Agents are a new way of working.
					<strong>They need a new organizing paradigm.</strong>
				</p>
			</section>

			<section class="section paradigm-section" id="paradigm">
				<div class="section-intro">
					<p class="eyebrow">01 · Name the inherited default</p>
					<h2>Your repository became your agent’s accidental Home.</h2>
					<p>
						Trying an agent or a methodology should not require remodeling
						the product repository. But Target-first makes every experiment
						part of the Target’s structure.
					</p>
				</div>

				<div class="explainer paradigm-explainer">
					<div class="explainer-toolbar">
						<div>
							<small>Interactive explainer</small>
							<strong>Where does the agentic environment live?</strong>
						</div>
						<div class="segmented" role="group" aria-label="Paradigm view">
							<button type="button" data-paradigm-button="target" aria-pressed="true">
								Target-first
							</button>
							<button type="button" data-paradigm-button="home" aria-pressed="false">
								Home-first
							</button>
						</div>
					</div>

					<div class="paradigm-stage" data-paradigm-stage data-mode="target">
						<div class="stage-status">
							<p data-paradigm-kicker>THE ACCIDENTAL DEFAULT</p>
							<strong data-paradigm-title>The Target owns the plumbing.</strong>
							<span data-paradigm-copy>
								Methods, provider files and working outputs accumulate around
								each product.
							</span>
						</div>

						<div class="home-field">
							<small>Owned collaboration environment</small>
							<strong>Hairness Home</strong>
							<div class="home-contents">
								<span>Agentic Assets</span>
								<span>Desk</span>
								<span>Artifacts</span>
							</div>
						</div>

						<div class="repo repo-one">
							<div class="repo-title"><i></i><strong>product-a/</strong></div>
							<span class="product-file">src/</span>
							<span class="product-file">tests/</span>
							<span class="plumbing-file">.agents/</span>
							<span class="plumbing-file">.planning/</span>
							<span class="plumbing-file">AGENTS.md</span>
						</div>

						<div class="repo repo-two">
							<div class="repo-title"><i></i><strong>product-b/</strong></div>
							<span class="product-file">app/</span>
							<span class="product-file">docs/</span>
							<span class="plumbing-file">.claude/</span>
							<span class="plumbing-file">.specify/</span>
							<span class="plumbing-file">plans/</span>
						</div>

						<span class="fragment fragment-skill" style="--tx: 8%; --ty: 53%; --hx: 41%; --hy: 50%;">skills</span>
						<span class="fragment fragment-command" style="--tx: 34%; --ty: 75%; --hx: 50%; --hy: 58%;">commands</span>
						<span class="fragment fragment-agent" style="--tx: 68%; --ty: 49%; --hx: 57%; --hy: 49%;">agents</span>
						<span class="fragment fragment-method" style="--tx: 83%; --ty: 73%; --hx: 46%; --hy: 67%;">methods</span>
						<span class="fragment fragment-rules" style="--tx: 17%; --ty: 82%; --hx: 59%; --hy: 67%;">rules</span>

						<i class="binding binding-one" aria-hidden="true"></i>
						<i class="binding binding-two" aria-hidden="true"></i>
					</div>

					<div class="stage-footer">
						<p data-paradigm-conclusion>
							<strong>Target-first makes experimentation invasive.</strong>
							Which files belong to the product—and which belong to the way
							an agent happened to work today?
						</p>
					</div>
				</div>
			</section>

			<section class="shift-statement">
				<div>
					<p class="eyebrow">The Home-first shift</p>
					<h2>Keep the product in the Target. Own the way of working in a Home.</h2>
				</div>
				<p>
					Target-first organizes agents around repositories. Home-first
					organizes work around an owned human-agent collaboration.
				</p>
			</section>

			<section class="section asset-section" id="assets">
				<div class="section-intro section-intro-wide">
					<p class="eyebrow">02 · Name what you own</p>
					<h2>Stop organizing formats. Start owning Assets.</h2>
					<p>
						Skills, commands and agent definitions are delivery forms.
						Hairness gives the reusable source behind them a durable
						abstraction: the Agentic Asset.
					</p>
				</div>

				<div class="explainer asset-explainer">
					<div class="asset-cloud" aria-label="Examples of agentic formats">
						<span style="--i: 0">skill</span>
						<span style="--i: 1">command</span>
						<span style="--i: 2">prompt</span>
						<span style="--i: 3">agent definition</span>
						<span style="--i: 4">workflow</span>
						<span style="--i: 5">rule</span>
						<span style="--i: 6">method</span>
						<span style="--i: 7">tool configuration</span>
					</div>

					<div class="lens-arrow" aria-hidden="true">
						<i></i><span>normalize + own</span>
					</div>

					<div class="asset-core">
						<small>Source-owned</small>
						<strong>AGENTIC<br />ASSET</strong>
						<div>
							<span>inspectable</span>
							<span>versioned</span>
							<span>portable</span>
						</div>
					</div>

					<div class="lens-arrow arrow-project" aria-hidden="true">
						<i></i><span>project</span>
					</div>

					<div class="projection">
						<div class="segmented provider-switch" role="group" aria-label="Provider projection">
							<button type="button" data-provider="codex" aria-pressed="true">Codex</button>
							<button type="button" data-provider="claude" aria-pressed="false">Claude</button>
						</div>
						<div class="projection-output" data-projection-output>
							<small>Codex projection</small>
							<strong>Native surfaces</strong>
							<span>skills/ · AGENTS.md · commands</span>
						</div>
					</div>
				</div>

				<p class="asset-thesis">
					<strong>Skills and commands are delivery formats.</strong>
					Assets are what you own.
				</p>
			</section>

			<section class="section ownership-section">
				<div class="section-intro">
					<p class="eyebrow">03 · Make ownership visible</p>
					<h2>One system. A clear owner for every part.</h2>
				</div>

				<div class="ownership-map">
					<div class="ownership-provider">
						<small>Providers</small>
						<strong>Execute</strong>
						<span>Codex · Claude</span>
					</div>
					<i aria-hidden="true">→</i>
					<div class="ownership-home">
						<small>Hairness Home</small>
						<strong>Owns</strong>
						<span>Assets · continuity · provenance</span>
					</div>
					<i aria-hidden="true">→</i>
					<div class="ownership-target">
						<small>Targets</small>
						<strong>Deliver</strong>
						<span>code · history · product</span>
					</div>
				</div>

				<div class="laws" aria-label="Home-first ownership laws">
					<span>Provider ≠ Owner</span>
					<span>Home ≠ Target</span>
					<span>Asset ≠ Artifact</span>
					<span>Source ≠ Projection</span>
					<span>Capability ≠ Skill</span>
				</div>
			</section>

			<section class="section collaboration-section" id="collaboration">
				<div class="section-intro">
					<p class="eyebrow">04 · Give collaboration a structure</p>
					<h2>Share the Home. Keep a Desk of your own.</h2>
					<p>
						The Home holds the shared canon. Your Desk holds local continuity,
						drafts and Bindings until you deliberately promote what should be kept.
					</p>
				</div>

				<div class="explainer collaboration-explainer">
					<div class="collab-world" data-collab-world>
						<div class="collab-node provider-node" data-collab-node="provider">
							<small>Replaceable Provider</small>
							<strong>Agent session</strong>
						</div>

						<div class="shared-home" data-collab-node="home">
							<div>
								<small>SHARED CANON</small>
								<strong>Home</strong>
							</div>
							<span>Agentic Assets</span>
							<span>Accepted Artifacts</span>
							<span>Conventions</span>
						</div>

						<div class="private-desk" data-collab-node="desk">
							<div>
								<small>PRIVATE CONTINUITY</small>
								<strong>Your Desk</strong>
							</div>
							<span>Drafts</span>
							<span>Working Artifacts</span>
							<span>Local Bindings</span>
						</div>

						<div class="human-node" data-collab-node="human">
							<i aria-hidden="true"></i>
							<div><small>Direction + judgment</small><strong>Human</strong></div>
						</div>

						<div class="target-node" data-collab-node="target">
							<small>Independent Target</small>
							<strong>Product repository</strong>
						</div>

						<div class="artifact-node" data-collab-node="artifact">
							<small>Evidence returns</small>
							<strong>Artifact</strong>
						</div>

						<i class="collab-line line-provider" aria-hidden="true"></i>
						<i class="collab-line line-home-desk" aria-hidden="true"></i>
						<i class="collab-line line-desk-target" aria-hidden="true"></i>
						<i class="collab-line line-return" aria-hidden="true"></i>
					</div>

					<div class="collab-controls">
						<div role="group" aria-label="Collaboration loop step">
							<button type="button" data-collab-step="0" aria-pressed="true">1 · Equip</button>
							<button type="button" data-collab-step="1" aria-pressed="false">2 · Enter</button>
							<button type="button" data-collab-step="2" aria-pressed="false">3 · Work</button>
							<button type="button" data-collab-step="3" aria-pressed="false">4 · Return</button>
							<button type="button" data-collab-step="4" aria-pressed="false">5 · Curate</button>
						</div>
						<p data-collab-caption>
							<strong>The Home equips the Desk.</strong>
							Shared Assets become available without turning private work into shared canon.
						</p>
					</div>
				</div>
			</section>

			<section class="capital-section">
				<div class="capital-ring" aria-hidden="true">
					<span>Asset</span><i>→</i><span>Work</span><i>→</i><span>Artifact</span
					><i>→</i><span>Human judgment</span><i>→</i><strong>Better Asset</strong>
				</div>
				<div>
					<p class="eyebrow">Owned agentic capital</p>
					<h2>Make every session leave the next one stronger.</h2>
					<p>
						Artifacts capture what happened. Human curation decides what
						compounds. The Home keeps the result independent from the session
						that produced it.
					</p>
				</div>
			</section>

			<section class="section homes-section">
				<div class="section-intro section-intro-wide">
					<p class="eyebrow">05 · Think in environments</p>
					<h2>Adopt a Home, not a pile of skills.</h2>
					<p>
						A Home can encode how a domain approaches work—not just which
						commands happen to be installed.
					</p>
				</div>

				<div class="home-concepts">
					<div class="concept-names">
						<span>Game Development</span>
						<span>Design</span>
						<span>Research</span>
					</div>
					<div class="concept-blueprint">
						<p>Concept · Not installable yet</p>
						<strong>A Home built for the work.</strong>
						<div>
							<span>domain Assets</span>
							<span>working conventions</span>
							<span>meaningful Artifacts</span>
							<span>independent Targets</span>
						</div>
					</div>
				</div>

				<p class="home-question">
					If your agents had a Home, <em>what would yours be built for?</em>
				</p>
			</section>

			<section class="start-section" id="start">
				<div>
					<p class="eyebrow eyebrow-light">Hairness 0.5 alpha</p>
					<h2>The paradigm already runs.</h2>
					<p>
						Create a source-owned Home with a Desk, Assets, Artifacts,
						Bindings and independent Targets. Use Codex and Claude today.
					</p>
				</div>
				<div class="terminal">
					<div><i></i><i></i><i></i><span>create a Home</span></div>
					<code>{createCommand}</code>
					<button type="button" data-copy={createCommand}>Copy</button>
				</div>
				<div class="start-actions">
					<a class="button button-light" href="https://github.com/thevzion/hairness">
						View on GitHub ↗
					</a>
					<a class="text-link" href="/home-first/">Explore Home-first →</a>
				</div>
				<p class="alpha-note">
					Open framework · Specialized Homes are still conceptual · Broader
					provider integrations remain future work
				</p>
			</section>
		</main>

		<footer>
			<a class="wordmark" href="#top"><i aria-hidden="true"></i>hairness</a>
			<p>Own the place where humans and agents build what comes next.</p>
			<a href="/lab/">Iteration lab</a>
		</footer>

		<script>
			const paradigmStage = document.querySelector<HTMLElement>('[data-paradigm-stage]');
			const paradigmButtons =
				document.querySelectorAll<HTMLButtonElement>('[data-paradigm-button]');
			const paradigmKicker = document.querySelector<HTMLElement>('[data-paradigm-kicker]');
			const paradigmTitle = document.querySelector<HTMLElement>('[data-paradigm-title]');
			const paradigmCopy = document.querySelector<HTMLElement>('[data-paradigm-copy]');
			const paradigmConclusion =
				document.querySelector<HTMLElement>('[data-paradigm-conclusion]');

			const paradigmContent = {
				target: {
					kicker: 'THE ACCIDENTAL DEFAULT',
					title: 'The Target owns the plumbing.',
					copy: 'Methods, provider files and working outputs accumulate around each product.',
					conclusion:
						'<strong>Target-first makes experimentation invasive.</strong> Which files belong to the product—and which belong to the way an agent happened to work today?',
				},
				home: {
					kicker: 'THE HOME-FIRST SHIFT',
					title: 'The Home owns the environment.',
					copy: 'Agentic Assets move into an explicit source-owned system. Bindings keep every Target independent.',
					conclusion:
						'<strong>Home-first makes experimentation reversible.</strong> Change the way of working without remodeling the product being worked on.',
				},
			};

			paradigmButtons.forEach((button) => {
				button.addEventListener('click', () => {
					const mode = button.dataset.paradigmButton as keyof typeof paradigmContent;
					const content = paradigmContent[mode];
					if (!paradigmStage || !content) return;

					paradigmStage.dataset.mode = mode;
					paradigmButtons.forEach((candidate) => {
						candidate.setAttribute(
							'aria-pressed',
							String(candidate === button),
						);
					});
					if (paradigmKicker) paradigmKicker.textContent = content.kicker;
					if (paradigmTitle) paradigmTitle.textContent = content.title;
					if (paradigmCopy) paradigmCopy.textContent = content.copy;
					if (paradigmConclusion) paradigmConclusion.innerHTML = content.conclusion;
				});
			});

			const providerButtons =
				document.querySelectorAll<HTMLButtonElement>('[data-provider]');
			const projectionOutput =
				document.querySelector<HTMLElement>('[data-projection-output]');
			const projections = {
				codex: ['Codex projection', 'Native surfaces', 'skills/ · AGENTS.md · commands'],
				claude: ['Claude projection', 'Native surfaces', 'agents/ · CLAUDE.md · commands'],
			};

			providerButtons.forEach((button) => {
				button.addEventListener('click', () => {
					const provider = button.dataset.provider as keyof typeof projections;
					const content = projections[provider];
					if (!projectionOutput || !content) return;

					providerButtons.forEach((candidate) => {
						candidate.setAttribute('aria-pressed', String(candidate === button));
					});
					const [small, strong, span] = projectionOutput.children;
					if (small) small.textContent = content[0];
					if (strong) strong.textContent = content[1];
					if (span) span.textContent = content[2];
					projectionOutput.animate(
						[
							{ opacity: 0.35, transform: 'translateY(4px)' },
							{ opacity: 1, transform: 'translateY(0)' },
						],
						{ duration: 220, easing: 'ease-out' },
					);
				});
			});

			const collabButtons =
				document.querySelectorAll<HTMLButtonElement>('[data-collab-step]');
			const collabNodes =
				document.querySelectorAll<HTMLElement>('[data-collab-node]');
			const collabCaption =
				document.querySelector<HTMLElement>('[data-collab-caption]');
			const collabSteps = [
				{
					nodes: ['home', 'desk'],
					copy: '<strong>The Home equips the Desk.</strong> Shared Assets become available without turning private work into shared canon.',
				},
				{
					nodes: ['provider', 'desk'],
					copy: '<strong>The agent enters through a replaceable Provider.</strong> The Desk preserves local continuity beyond the session.',
				},
				{
					nodes: ['desk', 'target'],
					copy: '<strong>A Binding reaches an independent Target.</strong> The product keeps its own code, history and delivery.',
				},
				{
					nodes: ['target', 'artifact', 'desk'],
					copy: '<strong>Evidence returns as an Artifact.</strong> The result belongs to the collaboration, not to a disappearing chat.',
				},
				{
					nodes: ['artifact', 'human', 'home'],
					copy: '<strong>Human judgment decides what compounds.</strong> A selected Artifact can become shared knowledge or a better Asset.',
				},
			];

			collabButtons.forEach((button) => {
				button.addEventListener('click', () => {
					const index = Number(button.dataset.collabStep);
					const step = collabSteps[index];
					if (!step) return;

					collabButtons.forEach((candidate) => {
						candidate.setAttribute('aria-pressed', String(candidate === button));
					});
					collabNodes.forEach((node) => {
						node.classList.toggle(
							'is-active',
							step.nodes.includes(node.dataset.collabNode ?? ''),
						);
					});
					if (collabCaption) collabCaption.innerHTML = step.copy;
				});
			});

			collabNodes.forEach((node) => {
				node.classList.toggle(
					'is-active',
					['home', 'desk'].includes(node.dataset.collabNode ?? ''),
				);
			});

			const copyButton = document.querySelector<HTMLButtonElement>('[data-copy]');
			copyButton?.addEventListener('click', async () => {
				const command = copyButton.dataset.copy;
				if (!command || !navigator.clipboard) return;
				await navigator.clipboard.writeText(command);
				copyButton.textContent = 'Copied';
				window.setTimeout(() => {
					copyButton.textContent = 'Copy';
				}, 1400);
			});
		</script>
	</body>
</html>

<style>
	:root {
		--lab-night: #111715;
		--lab-green: #314b40;
		--lab-copper: #c55f37;
		--lab-blue: #78aebb;
	}

	:global(html) {
		scroll-padding-top: 7rem;
	}

	:global(body) {
		background:
			radial-gradient(circle at 8% 5%, rgba(197, 95, 55, 0.11), transparent 30rem),
			radial-gradient(circle at 92% 3%, rgba(120, 174, 187, 0.12), transparent 34rem),
			var(--paper);
	}

	.lab-rail {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 34px;
		padding-inline: max(1rem, calc((100% - 1320px) / 2));
		background: var(--lab-night);
		color: rgba(255, 255, 255, 0.68);
		font-size: 0.65rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.lab-rail a {
		color: white;
		text-decoration: none;
	}

	.lab-rail strong {
		color: var(--sand);
	}

	.site-nav {
		position: sticky;
		top: 0;
		z-index: 30;
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 2rem;
		width: 100%;
		min-height: 76px;
		padding-inline: max(1rem, calc((100% - 1320px) / 2));
		border-bottom: 1px solid rgba(184, 170, 145, 0.64);
		background: rgba(244, 239, 229, 0.9);
		backdrop-filter: blur(18px);
	}

	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		font-size: 1.1rem;
		font-weight: 900;
		letter-spacing: -0.035em;
		text-decoration: none;
	}

	.wordmark i {
		position: relative;
		display: inline-block;
		width: 1.55rem;
		height: 1.4rem;
		border-radius: 0.2rem;
		background: var(--lab-night);
