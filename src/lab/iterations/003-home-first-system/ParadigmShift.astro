<figure class="shift" data-shift-root data-mode="target" aria-labelledby="shift-title">
	<header class="shift-header">
		<div>
			<p>Flagship interactive explainer</p>
			<h2 id="shift-title">Same system. Clear ownership.</h2>
		</div>
		<div class="shift-switch" role="group" aria-label="Agentic organization paradigm">
			<button type="button" data-shift-mode="target" aria-pressed="true">
				<span>Current default</span>
				Target-first
			</button>
			<button type="button" data-shift-mode="home" aria-pressed="false">
				<span>New paradigm</span>
				Home-first
			</button>
		</div>
	</header>

	<div class="shift-status" aria-live="polite">
		<span data-shift-state>Target-first</span>
		<strong data-shift-headline>The Targets own the agentic plumbing.</strong>
		<p data-shift-description>
			Methods, agent definitions and working outputs accumulate around each
			product.
		</p>
	</div>

	<div class="shift-stage">
		<section class="provider-band" aria-label="Providers and generic utilities">
			<div>
				<small>Providers host sessions</small>
				<strong>Codex</strong>
				<strong>Claude</strong>
			</div>
			<p>
				<span>GitHub</span>
				<span>Slack</span>
				<span>Ponytail</span>
				<small>Generic utilities can stay Provider-managed</small>
			</p>
		</section>

		<div class="workspace">
			<section class="home-space" aria-label="Hairness Home">
				<header>
					<div>
						<small>Source-owned environment</small>
						<strong>Hairness Home</strong>
					</div>
					<span>Front Door</span>
				</header>

				<div class="home-source">
					<p><span>SHARED SOURCE</span>Agentic Assets</p>
					<div class="asset-shelf" id="shift-home-assets"></div>
					<small>Reusable products for work</small>
				</div>

				<div class="home-desk">
					<p><span>PRIVATE CONTINUITY</span>Your Desk</p>
					<div class="artifact-shelf" id="shift-desk-artifacts"></div>
					<small>Drafts and working Artifacts stay local until selected</small>
				</div>

				<footer>
					<span>Owned</span>
					<span>Inspectable</span>
					<span>Versioned</span>
					<span>Portable</span>
				</footer>
			</section>

			<div class="binding-bridge" aria-hidden="true">
				<span>Bindings</span>
				<i></i>
			</div>

			<section class="targets-space" aria-label="Independent product Targets">
				<article class="repo">
					<header>
						<i aria-hidden="true"></i>
						<div><small>Target A</small><strong>storefront/</strong></div>
					</header>
					<div class="repo-tree">
						<span class="product">src/</span>
						<span class="product">tests/</span>
						<span class="product">docs/</span>
						<div class="token-slot" data-token-slot>
							<span
								class="move-token asset-token"
								data-destination="#shift-home-assets"
								data-target-label=".agents/review/"
								data-home-label="Review method"
							>.agents/review/</span>
							<span
								class="move-token asset-token"
								data-destination="#shift-home-assets"
								data-target-label="commands/ship.md"
								data-home-label="Ship workflow"
							>commands/ship.md</span>
						</div>
						<div class="token-slot" data-token-slot>
							<span
								class="move-token artifact-token"
								data-destination="#shift-desk-artifacts"
								data-target-label="plans/launch.md"
								data-home-label="Launch plan · Artifact"
							>plans/launch.md</span>
						</div>
					</div>
					<footer>code · history · delivery</footer>
				</article>

				<article class="repo">
					<header>
						<i aria-hidden="true"></i>
						<div><small>Target B</small><strong>platform-api/</strong></div>
					</header>
					<div class="repo-tree">
						<span class="product">app/</span>
						<span class="product">tests/</span>
						<span class="product">openapi/</span>
						<div class="token-slot" data-token-slot>
							<span
								class="move-token asset-token"
								data-destination="#shift-home-assets"
								data-target-label=".claude/researcher.md"
								data-home-label="Research agent"
							>.claude/researcher.md</span>
							<span
								class="move-token asset-token"
								data-destination="#shift-home-assets"
								data-target-label=".specify/memory/"
								data-home-label="Product method"
							>.specify/memory/</span>
						</div>
						<div class="token-slot" data-token-slot>
							<span
								class="move-token artifact-token"
								data-destination="#shift-desk-artifacts"
								data-target-label="research/notes.md"
								data-home-label="Research notes · Artifact"
							>research/notes.md</span>
						</div>
					</div>
					<footer>code · history · delivery</footer>
				</article>
			</section>
		</div>
	</div>

	<div class="shift-ledger" aria-label="What changes between paradigms">
		<p>
			<span>Product source</span>
			<strong data-ledger-product>Mixed with agentic infrastructure</strong>
		</p>
		<p>
			<span>Business Assets</span>
			<strong data-ledger-assets>Copied between Targets</strong>
		</p>
		<p>
			<span>Working outputs</span>
			<strong data-ledger-artifacts>Scattered through repositories</strong>
		</p>
		<p>
			<span>Providers</span>
			<strong data-ledger-providers>Formats become implicit sources</strong>
		</p>
	</div>

	<figcaption>
		<strong data-shift-caption-lead>Target-first makes experimentation invasive.</strong>
		<span data-shift-caption>
			The repository becomes an accidental Home for every method and Provider
			you try.
		</span>
	</figcaption>
</figure>

<script>
	const root = document.querySelector<HTMLElement>('[data-shift-root]');

	if (root) {
		const buttons = root.querySelectorAll<HTMLButtonElement>('[data-shift-mode]');
		const tokens = root.querySelectorAll<HTMLElement>('.move-token');
		const state = root.querySelector<HTMLElement>('[data-shift-state]');
		const headline = root.querySelector<HTMLElement>('[data-shift-headline]');
		const description = root.querySelector<HTMLElement>('[data-shift-description]');
		const captionLead = root.querySelector<HTMLElement>('[data-shift-caption-lead]');
		const caption = root.querySelector<HTMLElement>('[data-shift-caption]');
		const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

		const content = {
			target: {
				state: 'Target-first',
				headline: 'The Targets own the agentic plumbing.',
				description:
					'Methods, agent definitions and working outputs accumulate around each product.',
				captionLead: 'Target-first makes experimentation invasive.',
				caption:
					'The repository becomes an accidental Home for every method and Provider you try.',
				ledger: [
					'Mixed with agentic infrastructure',
					'Copied between Targets',
					'Scattered through repositories',
					'Formats become implicit sources',
				],
			},
			home: {
				state: 'Home-first',
				headline: 'The Home owns the agentic environment.',
				description:
					'The same system is reorganized around explicit Assets, private continuity and independent Targets.',
				captionLead: 'Home-first makes experimentation reversible.',
				caption:
					'Keep the tools and repositories you already use. Change what owns the environment.',
				ledger: [
					'Stays clean and product-owned',
					'Explicit, canonical and reusable',
					'Return to the Desk as Artifacts',
					'Become replaceable projections',
				],
			},
		};

		const ledger = [
			root.querySelector<HTMLElement>('[data-ledger-product]'),
			root.querySelector<HTMLElement>('[data-ledger-assets]'),
			root.querySelector<HTMLElement>('[data-ledger-artifacts]'),
			root.querySelector<HTMLElement>('[data-ledger-providers]'),
		];

		tokens.forEach((token, index) => {
			const origin = token.parentElement;
			if (!origin) return;
			origin.id ||= `shift-origin-${index}`;
			token.dataset.origin = `#${origin.id}`;
		});

		const move = (mode: keyof typeof content) => {
			const next = content[mode];
			if (!next || root.dataset.mode === mode) return;

			const before = new Map(
				[...tokens].map((token) => [token, token.getBoundingClientRect()]),
			);

			root.dataset.mode = mode;

			tokens.forEach((token) => {
				const selector =
					mode === 'home' ? token.dataset.destination : token.dataset.origin;
				const destination = selector ? root.querySelector(selector) : null;
				if (!destination) return;
				destination.append(token);
				token.textContent =
					mode === 'home'
						? token.dataset.homeLabel ?? token.textContent
						: token.dataset.targetLabel ?? token.textContent;
			});

			if (state) state.textContent = next.state;
			if (headline) headline.textContent = next.headline;
			if (description) description.textContent = next.description;
			if (captionLead) captionLead.textContent = next.captionLead;
			if (caption) caption.textContent = next.caption;
			ledger.forEach((item, index) => {
				if (item) item.textContent = next.ledger[index] ?? '';
			});

			buttons.forEach((button) => {
				button.setAttribute(
					'aria-pressed',
					String(button.dataset.shiftMode === mode),
				);
			});

			requestAnimationFrame(() => {
				tokens.forEach((token) => {
					const first = before.get(token);
					if (!first) return;
					const last = token.getBoundingClientRect();
					const deltaX = first.left - last.left;
					const deltaY = first.top - last.top;
					if (reducedMotion.matches) return;

					token.animate(
						[
							{ transform: `translate(${deltaX}px, ${deltaY}px)`, zIndex: 20 },
							{ transform: 'translate(0, 0)', zIndex: 20 },
						],
						{
							duration: 620,
							easing: 'cubic-bezier(.2,.8,.2,1)',
						},
					);
				});
			});
		};

		buttons.forEach((button) => {
			button.addEventListener('click', () => {
				const mode = button.dataset.shiftMode;
				if (mode === 'target' || mode === 'home') move(mode);
			});
		});
	}
</script>

