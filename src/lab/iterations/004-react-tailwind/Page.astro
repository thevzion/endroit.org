---
import ParadigmShift from './ParadigmShift';
import ProviderProjection from './ProviderProjection';
import './theme.css';

const createCommand = 'npx --yes @hairness/cli@latest create my-home';

const mentalShifts = [
	{
		from: 'Skill',
		fromType: 'Invocation format',
		to: 'Agentic Asset',
		toType: 'Ownership unit',
		copy: 'A Skill says how a capability is invoked. An Asset is the reusable source the Home owns.',
		examples: 'Skills · commands · agents · prompts · methods',
	},
	{
		from: 'Output',
		fromType: 'Ephemeral result',
		to: 'Artifact',
		toType: 'Durable evidence',
		copy: 'A result gains provenance, continuity, and an explicit path to review or promotion.',
		examples: 'Plans · research · reviews · decisions · maps',
	},
	{
		from: 'Repository',
		fromType: 'Accidental center',
		to: 'Target',
		toType: 'Independent destination',
		copy: 'The product keeps its source, history, and delivery. A Binding lets the Home reach it.',
		examples: 'Application · API · documentation · any other repo',
	},
	{
		from: 'Provider config',
		fromType: 'Implicit source',
		to: 'Projection',
		toType: 'Replaceable surface',
		copy: 'Provider-native files are generated from canonical Home sources, not treated as their owner.',
		examples: 'AGENTS.md · CLAUDE.md · provider Skills and commands',
	},
	{
		from: 'Session',
		fromType: 'Temporary continuity',
		to: 'Home + Desk',
		toType: 'Owned collaboration',
		copy: 'Shared canon and private working continuity become distinct, inspectable places.',
		examples: 'Home conventions · local drafts · working Artifacts · Bindings',
	},
	{
		from: 'Skill bundle',
		fromType: 'List of capabilities',
		to: 'Specialized Home',
		toType: 'Domain environment',
		copy: 'Adopt a coherent way to approach work, not only another pile of things to invoke.',
		examples: 'Game Development · Design · Research',
	},
];

const conceptualHomes = [
	{
		name: 'Game Development',
		promise: 'From design intent to playable Targets.',
		assets: 'game design · systems · playtesting · release',
		artifacts: 'design briefs · balance reports · playtest findings',
	},
	{
		name: 'Design',
		promise: 'A durable environment for taste and critique.',
		assets: 'principles · visual language · critique methods',
		artifacts: 'directions · audits · explorations · decisions',
	},
	{
		name: 'Research',
		promise: 'Evidence that compounds instead of disappearing.',
		assets: 'questions · methods · evaluation standards',
		artifacts: 'source maps · syntheses · findings · open questions',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex, nofollow" />
		<meta
			name="description"
			content="A local React and Tailwind iteration of the Hairness Home-first landing."
		/>
		<title>Hairness — Home-first landing 004</title>
	</head>
	<body>
		<div class="flex min-h-[34px] items-center justify-between gap-4 bg-ink px-[max(1rem,calc((100%_-_68rem)/2))] text-[0.58rem] font-bold uppercase tracking-[0.1em] text-white/55">
			<a class="text-white no-underline" href="/lab/">← Iterations</a>
			<span>004 · React + Tailwind system</span>
			<strong class="text-paper-deep">Local only</strong>
		</div>

		<div class="v4-shell">
			<header class="sticky top-0 z-40 grid min-h-[70px] grid-cols-[auto_1fr_auto] items-center gap-8 border-b border-line bg-paper/90 px-[clamp(1.25rem,4vw,3.25rem)] backdrop-blur-xl">
				<a class="flex items-center gap-2.5 font-black tracking-[-0.04em] no-underline" href="#top" aria-label="Hairness home">
					<span class="grid size-7 rotate-45 place-items-center bg-ink" aria-hidden="true"><i class="size-2.5 -rotate-45 bg-paper"></i></span>
					hairness
				</a>
				<nav class="hidden justify-center gap-7 text-xs font-bold md:flex" aria-label="Main navigation">
					<a class="no-underline hover:text-copper" href="#shift">Paradigm</a>
					<a class="no-underline hover:text-copper" href="#model">Mental model</a>
					<a class="no-underline hover:text-copper" href="#collaboration">Collaboration</a>
				</nav>
				<a class="border border-ink bg-ink px-3 py-2 text-xs font-bold text-white no-underline hover:bg-copper" href="#start">
					Create your Home
				</a>
			</header>

			<main id="top">
				<section class="border-b border-line px-[clamp(1.25rem,4vw,3.25rem)] py-[clamp(6rem,13vw,10rem)]">
					<p class="m-0 text-[0.62rem] font-black uppercase tracking-[0.14em] text-copper">
						The Home-first framework for agentic work.
					</p>
					<h1 class="my-5 max-w-[58rem] text-[clamp(3.6rem,9vw,7.3rem)] leading-[0.9] font-black tracking-[-0.075em]">
						Your agentic stack already exists.
						<em class="mt-2 block font-editorial font-normal text-copper">Give it a Home.</em>
					</h1>
					<p class="max-w-[46rem] text-[clamp(1rem,2vw,1.25rem)] leading-relaxed text-muted">
						Hairness is an open, Home-first framework for building a source-owned
						human-agent work environment around the providers, repositories, and
						agentic tools <strong class="font-semibold text-ink">you already use.</strong>
					</p>
					<div class="mt-8 flex flex-wrap gap-2.5">
						<a class="min-h-12 bg-copper px-5 py-3 text-sm font-bold text-white no-underline hover:bg-copper-dark" href="#shift">
							See the Home-first shift
						</a>
						<a class="min-h-12 border border-line-strong bg-paper-soft px-5 py-3 text-sm font-bold no-underline hover:border-ink" href="#start">
							Create your Home
						</a>
					</div>
					<p class="mt-6 flex flex-wrap gap-2 text-[0.58rem] font-bold uppercase tracking-[0.09em] text-muted">
						<span>Open source</span><i class="not-italic text-copper">·</i>
						<span>Codex + Claude today</span><i class="not-italic text-copper">·</i>
						<span>Hairness 0.5 alpha</span>
					</p>
				</section>

				<section class="border-b border-line bg-ink px-[clamp(1.25rem,4vw,3.25rem)] py-[clamp(4.5rem,9vw,7rem)] text-white">
					<p class="m-0 max-w-[58rem] text-[clamp(2.2rem,5vw,4.8rem)] leading-[1.02] font-semibold tracking-[-0.06em]">
						Agents are a new way of working.
						<strong class="font-editorial font-normal text-paper-deep">They need a new organizing paradigm.</strong>
					</p>
				</section>

				<section class="border-b border-line py-[clamp(5.5rem,11vw,9rem)]" id="shift">
					<header class="mb-12 grid gap-8 px-[clamp(1.25rem,4vw,3.25rem)] md:grid-cols-[1.15fr_0.65fr] md:items-end">
						<div>
							<p class="m-0 text-[0.6rem] font-black uppercase tracking-[0.14em] text-copper">01 / The paradigm shift</p>
							<h2 class="mt-3 mb-0 text-[clamp(2.8rem,6vw,5.4rem)] leading-[0.95] font-black tracking-[-0.065em]">
								Keep the system.<br />Change what owns it.
							</h2>
						</div>
						<p class="m-0 text-sm leading-relaxed text-muted">
							Target-first turns repositories into accidental agent Homes.
							Home-first reorganizes the same system around explicit ownership.
						</p>
					</header>
					<ParadigmShift client:visible={{ rootMargin: '240px' }} />
					<p class="mx-[clamp(1.25rem,4vw,3.25rem)] mt-14 mb-0 max-w-[50rem] text-[clamp(2rem,4.5vw,4rem)] leading-[1.04] font-semibold tracking-[-0.055em]">
						Hairness doesn’t replace your agentic stack.
						<strong class="font-editorial font-normal text-copper">It gives it a Home.</strong>
					</p>
					<p class="mx-[clamp(1.25rem,4vw,3.25rem)] mt-5 max-w-[46rem] text-xs leading-relaxed text-muted">
						GSD, BMAD, Spec Kit, Superpowers, Ponytail, and similar methods are
						examples of capabilities a Home could organize—not claimed Hairness integrations.
					</p>
				</section>

				<section class="border-b border-line py-[clamp(5.5rem,11vw,9rem)]" id="model">
					<header class="mb-12 grid gap-8 px-[clamp(1.25rem,4vw,3.25rem)] md:grid-cols-[1.15fr_0.65fr] md:items-end">
						<div>
							<p class="m-0 text-[0.6rem] font-black uppercase tracking-[0.14em] text-copper">02 / The mental model</p>
							<h2 class="mt-3 mb-0 text-[clamp(2.8rem,6vw,5.4rem)] leading-[0.95] font-black tracking-[-0.065em]">
								Name the system above the tools.
							</h2>
						</div>
						<p class="m-0 text-sm leading-relaxed text-muted">
							The usual words describe delivery formats. Hairness adds the
							ownership and lifecycle abstractions they were missing.
						</p>
					</header>

					<div class="border-t border-line-strong">
						{mentalShifts.map((shift, index) => (
							<article class="grid gap-4 border-b border-line px-[clamp(1.25rem,4vw,3.25rem)] py-7 md:grid-cols-[2.5rem_0.6fr_2rem_1.1fr] md:items-center">
								<span class="font-mono text-[0.6rem] font-bold text-copper">{String(index + 1).padStart(2, '0')}</span>
								<div>
									<small class="block text-[0.52rem] font-bold uppercase tracking-[0.1em] text-muted">{shift.fromType}</small>
									<strong class="text-xl tracking-[-0.035em]">{shift.from}</strong>
								</div>
								<i class="not-italic text-line-strong" aria-hidden="true">→</i>
								<div>
									<small class="block text-[0.52rem] font-bold uppercase tracking-[0.1em] text-copper">{shift.toType}</small>
									<strong class="text-xl tracking-[-0.035em]">{shift.to}</strong>
									<p class="my-2 max-w-[38rem] text-xs leading-relaxed text-muted">{shift.copy}</p>
									<p class="m-0 font-mono text-[0.55rem] leading-relaxed text-muted">{shift.examples}</p>
								</div>
							</article>
						))}
					</div>
				</section>

				<section class="border-b border-line bg-paper-soft py-[clamp(5.5rem,11vw,9rem)]" id="collaboration">
					<header class="mb-12 grid gap-8 px-[clamp(1.25rem,4vw,3.25rem)] md:grid-cols-[1.15fr_0.65fr] md:items-end">
						<div>
							<p class="m-0 text-[0.6rem] font-black uppercase tracking-[0.14em] text-sky">03 / Human-agent collaboration</p>
							<h2 class="mt-3 mb-0 text-[clamp(2.8rem,6vw,5.4rem)] leading-[0.95] font-black tracking-[-0.065em]">
								Share the Home.<br />Keep a Desk of your own.
							</h2>
						</div>
						<p class="m-0 text-sm leading-relaxed text-muted">
							The Home holds what collaboration should inherit. The Desk holds
							what you and your agents are still working through.
						</p>
					</header>

					<div class="v4-grid-paper mx-[clamp(1.25rem,4vw,3.25rem)] grid gap-3 border-y border-line-strong p-4 md:grid-cols-[0.5fr_1.5fr_0.6fr] md:items-center md:p-7">
						<aside class="border border-line-strong bg-paper p-4">
							<small class="text-[0.52rem] font-bold uppercase tracking-[0.1em] text-muted">Replaceable entry</small>
							<strong class="mt-1 block">Agent session</strong>
							<span class="mt-3 block font-mono text-[0.58rem] text-muted">Codex · Claude</span>
						</aside>
						<section class="border border-ink bg-paper">
							<header class="flex items-start justify-between gap-4 bg-ink p-4 text-white">
								<div><small class="block text-[0.5rem] font-bold tracking-[0.1em] text-paper-deep">SHARED, SOURCE-OWNED CANON</small><strong class="text-xl">Home</strong></div>
								<span class="font-mono text-[0.52rem] text-white/55">Assets · conventions</span>
							</header>
							<div class="m-3 border border-sky/45 bg-sky-soft/65 p-4">
								<small class="text-[0.5rem] font-bold tracking-[0.1em] text-sky">PRIVATE CONTINUITY</small>
								<strong class="mt-1 block text-lg">Your Desk</strong>
								<p class="mb-0 mt-3 flex flex-wrap gap-1.5 text-[0.58rem] text-muted">
									<span class="border border-sky/35 px-2 py-1">drafts</span>
									<span class="border border-sky/35 px-2 py-1">working Artifacts</span>
									<span class="border border-sky/35 px-2 py-1">local Bindings</span>
								</p>
							</div>
						</section>
						<aside class="border border-line-strong bg-paper p-4">
							<small class="text-[0.52rem] font-bold uppercase tracking-[0.1em] text-muted">Through a Binding</small>
							<strong class="mt-1 block">Independent Target</strong>
							<span class="mt-3 block font-mono text-[0.58rem] text-muted">code · history · delivery</span>
						</aside>
					</div>

					<div class="mx-[clamp(1.25rem,4vw,3.25rem)] mt-5 flex flex-wrap items-center gap-2 font-mono text-[0.58rem] font-bold uppercase tracking-[0.06em] text-muted">
						<span>Equip</span><i>→</i><span>Enter</span><i>→</i><span>Reach Target</span><i>→</i>
						<span>Return Artifact</span><i>→</i><strong class="text-copper">Human curation</strong>
					</div>
				</section>

				<section class="border-b border-line py-[clamp(5.5rem,11vw,9rem)]">
					<header class="mb-12 px-[clamp(1.25rem,4vw,3.25rem)]">
						<p class="m-0 text-[0.6rem] font-black uppercase tracking-[0.14em] text-copper">04 / A compounding environment</p>
						<h2 class="mt-3 mb-0 max-w-[52rem] text-[clamp(2.8rem,6vw,5.4rem)] leading-[0.95] font-black tracking-[-0.065em]">
							Work returns home as evidence.
						</h2>
					</header>
					<div class="mx-[clamp(1.25rem,4vw,3.25rem)] grid border-y border-line-strong md:grid-cols-[1fr_auto_1fr_auto_1fr_auto_1fr] md:items-stretch">
						<div class="bg-copper/8 p-5"><small class="text-[0.52rem] font-bold uppercase tracking-[0.1em] text-copper">Product for work</small><strong class="mt-1 block text-xl">Asset</strong><p class="mb-0 text-xs text-muted">review method · research agent</p></div>
						<i class="grid place-items-center border-y border-line px-3 py-2 not-italic md:border-x md:border-y-0">→</i>
						<div class="p-5"><small class="text-[0.52rem] font-bold uppercase tracking-[0.1em] text-muted">Agent execution</small><strong class="mt-1 block text-xl">Work</strong><p class="mb-0 text-xs text-muted">apply · investigate · create</p></div>
						<i class="grid place-items-center border-y border-line px-3 py-2 not-italic md:border-x md:border-y-0">→</i>
						<div class="bg-sky-soft/65 p-5"><small class="text-[0.52rem] font-bold uppercase tracking-[0.1em] text-sky">Product of work</small><strong class="mt-1 block text-xl">Artifact</strong><p class="mb-0 text-xs text-muted">review · research · plan</p></div>
						<i class="grid place-items-center border-y border-line px-3 py-2 not-italic md:border-x md:border-y-0">→</i>
						<div class="bg-ink p-5 text-white"><small class="text-[0.52rem] font-bold uppercase tracking-[0.1em] text-paper-deep">Explicit gate</small><strong class="mt-1 block text-xl">Human judgment</strong><p class="mb-0 text-xs text-white/55">keep evidence or promote deliberately</p></div>
					</div>
					<p class="mx-[clamp(1.25rem,4vw,3.25rem)] mt-5 max-w-[47rem] text-sm leading-relaxed text-muted">
						An Artifact never silently becomes an Asset. Human curation can turn
						what was learned into a new or better reusable source.
					</p>
				</section>

				<section class="border-b border-line py-[clamp(5.5rem,11vw,9rem)]">
					<header class="mb-12 grid gap-8 px-[clamp(1.25rem,4vw,3.25rem)] md:grid-cols-[1.15fr_0.65fr] md:items-end">
						<div>
							<p class="m-0 text-[0.6rem] font-black uppercase tracking-[0.14em] text-sky">05 / Zero provider lock-in</p>
							<h2 class="mt-3 mb-0 text-[clamp(2.8rem,6vw,5.4rem)] leading-[0.95] font-black tracking-[-0.065em]">
								Own the source.<br />Project to the provider.
							</h2>
						</div>
						<p class="m-0 text-sm leading-relaxed text-muted">
							Use the native surfaces of each agent without letting any one of
							them become the owner of your way of working.
						</p>
					</header>
					<ProviderProjection client:visible={{ rootMargin: '240px' }} />
				</section>

				<section class="border-b border-line py-[clamp(5.5rem,11vw,9rem)]">
					<header class="mb-12 px-[clamp(1.25rem,4vw,3.25rem)]">
						<p class="m-0 text-[0.6rem] font-black uppercase tracking-[0.14em] text-copper">06 / The new unit of adoption</p>
						<h2 class="mt-3 mb-0 max-w-[55rem] text-[clamp(2.8rem,6vw,5.4rem)] leading-[0.95] font-black tracking-[-0.065em]">
							Adopt an environment, not a pile of Skills.
						</h2>
					</header>
					<div class="grid border-t border-line-strong md:grid-cols-3">
						{conceptualHomes.map((home) => (
							<article class="border-b border-line p-[clamp(1.25rem,3vw,2rem)] md:border-r md:last:border-r-0">
								<p class="m-0 font-mono text-[0.52rem] font-bold uppercase tracking-[0.1em] text-copper">Concept · Not installable yet</p>
								<h3 class="mt-4 mb-2 text-2xl tracking-[-0.04em]">{home.name}</h3>
								<p class="text-sm leading-relaxed text-muted">{home.promise}</p>
								<dl class="mt-7 border-t border-line pt-4 text-xs">
									<dt class="font-bold text-copper">Assets</dt><dd class="m-0 mt-1 text-muted">{home.assets}</dd>
									<dt class="mt-4 font-bold text-sky">Artifacts</dt><dd class="m-0 mt-1 text-muted">{home.artifacts}</dd>
								</dl>
							</article>
						))}
					</div>
					<p class="mx-[clamp(1.25rem,4vw,3.25rem)] mt-14 mb-0 max-w-[48rem] text-[clamp(2rem,4.5vw,4rem)] leading-[1.04] font-semibold tracking-[-0.055em]">
						If your agents had a Home,
						<em class="font-editorial font-normal text-copper">what would yours be built for?</em>
					</p>
				</section>

				<section class="bg-ink px-[clamp(1.25rem,4vw,3.25rem)] py-[clamp(5.5rem,11vw,8rem)] text-white" id="start">
					<div class="grid gap-10 md:grid-cols-[1fr_0.85fr] md:items-end">
						<div>
							<p class="m-0 text-[0.6rem] font-black uppercase tracking-[0.14em] text-paper-deep">Hairness 0.5 alpha</p>
							<h2 class="mt-3 mb-5 text-[clamp(3rem,7vw,6rem)] leading-[0.92] font-black tracking-[-0.07em]">
								The paradigm already runs.
							</h2>
							<p class="max-w-[40rem] text-sm leading-relaxed text-white/60">
								Create a source-owned Home with a Desk, Assets, Artifacts,
								Bindings, and independent Targets. Use Codex and Claude today.
							</p>
						</div>
						<div class="border border-white/20 bg-white/5">
							<header class="flex items-center gap-1.5 border-b border-white/15 px-4 py-3">
								<i class="size-2 rounded-full bg-copper"></i><i class="size-2 rounded-full bg-paper-deep"></i><i class="size-2 rounded-full bg-sky"></i>
								<small class="ml-auto font-mono text-[0.52rem] uppercase tracking-[0.1em] text-white/40">create a Home</small>
							</header>
							<div class="flex items-center gap-3 p-4">
								<code class="min-w-0 flex-1 overflow-x-auto font-mono text-[0.65rem] text-paper-deep">{createCommand}</code>
								<button class="border border-white/25 px-3 py-2 text-[0.58rem] font-bold uppercase tracking-[0.08em] hover:bg-white hover:text-ink" type="button" data-v4-copy={createCommand}>
									Copy
								</button>
							</div>
						</div>
					</div>
					<footer class="mt-10 flex flex-wrap items-center gap-5">
						<a class="bg-paper px-5 py-3 text-sm font-bold text-ink no-underline hover:bg-paper-deep" href="https://github.com/thevzion/hairness">
							View Hairness on GitHub ↗
						</a>
						<a class="text-sm font-bold text-white no-underline hover:text-paper-deep" href="/home-first/">Read the technical docs →</a>
					</footer>
					<small class="mt-7 block text-[0.55rem] uppercase tracking-[0.08em] text-white/35">
						Open framework · Specialized Homes remain conceptual · Broader integrations are future work
					</small>
				</section>
			</main>

			<footer class="flex flex-wrap items-center justify-between gap-4 border-t border-line bg-paper px-[clamp(1.25rem,4vw,3.25rem)] py-8 text-xs text-muted">
				<strong class="text-ink">hairness</strong>
				<p class="m-0">Own the place where humans and agents build what comes next.</p>
				<a class="font-bold text-ink no-underline" href="/lab/">Iteration lab</a>
			</footer>
		</div>

		<script>
			const copyButton = document.querySelector<HTMLButtonElement>('[data-v4-copy]');
			copyButton?.addEventListener('click', async () => {
				const command = copyButton.dataset.v4Copy;
				if (!command || !navigator.clipboard) return;
				await navigator.clipboard.writeText(command);
				copyButton.textContent = 'Copied';
				window.setTimeout(() => {
					copyButton.textContent = 'Copy';
				}, 1400);
			});
		</script>
	</body>
</html>
