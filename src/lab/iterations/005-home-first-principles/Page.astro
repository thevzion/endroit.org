---
import ParadigmShift from '../004-react-tailwind/ParadigmShift';
import ProviderProjection from '../004-react-tailwind/ProviderProjection';
import '../004-react-tailwind/theme.css';

const createCommand = 'npx --yes @hairness/cli@latest create my-home';

const vocabulary = [
	['Skill', 'Agentic Asset', 'invocation becomes owned source'],
	['Output', 'Artifact', 'a result gains provenance and continuity'],
	['Repository', 'Target', 'the product remains an independent destination'],
	['Provider config', 'Projection', 'native formats become replaceable outputs'],
	['Session', 'Home + Desk', 'collaboration gains a durable place'],
];

const homes = [
	['Game Development', 'systems · playtesting · releases'],
	['Design', 'principles · critique · visual language'],
	['Research', 'questions · evidence · synthesis'],
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex, nofollow" />
		<meta
			name="description"
			content="A local principle-led iteration of the Hairness Home-first landing."
		/>
		<title>Hairness — Home-first principles 005</title>
	</head>
	<body>
		<div class="flex min-h-[34px] items-center justify-between gap-4 bg-ink px-[max(1rem,calc((100%_-_68rem)/2))] text-[0.58rem] font-bold uppercase tracking-[0.1em] text-white/55">
			<a class="text-white no-underline" href="/lab/">← Iterations</a>
			<span>005 · Home-first principles</span>
			<strong class="text-paper-deep">Local only</strong>
		</div>

		<div class="v4-shell">
			<header class="sticky top-0 z-40 grid min-h-[70px] grid-cols-[auto_1fr_auto] items-center gap-8 border-b border-line bg-paper/90 px-[clamp(1.25rem,4vw,3.25rem)] backdrop-blur-xl">
				<a class="flex items-center gap-2.5 font-black tracking-[-0.04em] no-underline" href="#top" aria-label="Hairness home">
					<span class="grid size-7 rotate-45 place-items-center bg-ink" aria-hidden="true">
						<i class="size-2.5 -rotate-45 bg-paper"></i>
					</span>
					hairness
				</a>
				<nav class="hidden justify-center gap-6 text-[0.68rem] font-bold md:flex" aria-label="Main navigation">
					<a class="no-underline hover:text-copper" href="#shift">Home-first</a>
					<a class="no-underline hover:text-copper" href="#assets">Assets</a>
					<a class="no-underline hover:text-copper" href="#providers">Providers</a>
					<a class="no-underline hover:text-copper" href="#collaboration">Collaboration</a>
				</nav>
				<a class="border border-ink bg-ink px-3 py-2 text-xs font-bold text-white no-underline hover:bg-copper" href="#start">
					Create a Home
				</a>
			</header>

			<main id="top">
				<section class="grid gap-12 border-b border-line px-[clamp(1.25rem,4vw,3.25rem)] py-[clamp(5rem,11vw,8.5rem)] lg:grid-cols-[1.2fr_0.65fr] lg:items-center">
					<div>
						<p class="m-0 text-[0.62rem] font-black uppercase tracking-[0.14em] text-copper">
							The ownership layer for agentic work.
						</p>
						<h1 class="my-5 max-w-[48rem] text-[clamp(3.8rem,8vw,7rem)] leading-[0.9] font-black tracking-[-0.075em]">
							Give your agentic stack
							<em class="block font-editorial font-normal text-copper">a Home.</em>
						</h1>
						<p class="max-w-[45rem] text-[clamp(1rem,2vw,1.22rem)] leading-relaxed text-muted">
							Hairness is an open, Home-first framework that turns the
							providers, repositories, and agentic tools
							<strong class="font-semibold text-ink">you already use</strong>
							into a source-owned environment for human-agent collaboration.
						</p>
						<div class="mt-8 flex flex-wrap gap-2.5">
							<a class="min-h-12 bg-copper px-5 py-3 text-sm font-bold text-white no-underline hover:bg-copper-dark" href="#shift">
								See the paradigm shift
							</a>
							<a class="min-h-12 border border-line-strong bg-paper-soft px-5 py-3 text-sm font-bold no-underline hover:border-ink" href="#start">
								Create your Home
							</a>
						</div>
						<p class="mt-6 flex flex-wrap gap-2 text-[0.57rem] font-bold uppercase tracking-[0.09em] text-muted">
							<span>Open source</span><i class="not-italic text-copper">·</i>
							<span>Codex + Claude today</span><i class="not-italic text-copper">·</i>
							<span>Hairness 0.5 alpha</span>
						</p>
					</div>

					<aside class="v4-grid-paper border-y border-line-strong p-4" aria-label="Your existing agentic stack">
						<p class="mb-4 mt-0 font-mono text-[0.55rem] font-bold uppercase tracking-[0.12em] text-muted">
							The stack you already use
						</p>
						<div class="grid grid-cols-[1fr_auto] border border-line-strong bg-paper-soft">
							<div class="grid gap-2 border-r border-line p-4">
								<small class="font-mono text-[0.5rem] font-bold uppercase tracking-[0.1em] text-sky">Providers</small>
								<strong class="text-sm">Codex · Claude</strong>
								<small class="font-mono text-[0.5rem] font-bold uppercase tracking-[0.1em] text-copper">Methods & tools</small>
								<strong class="text-sm">Skills · agents · commands</strong>
								<small class="mt-2 text-[0.55rem] leading-relaxed text-muted">
									GSD · BMAD · Spec Kit · Superpowers · Ponytail are examples,
									not claimed integrations.
								</small>
							</div>
							<div class="grid place-items-center bg-ink px-3 text-white">
								<span class="font-mono text-[0.52rem] font-bold uppercase tracking-[0.12em] [writing-mode:vertical-rl]">
									Home-first
								</span>
							</div>
						</div>
						<div class="mt-3 grid grid-cols-3 border border-line-strong bg-paper text-center font-mono text-[0.55rem] font-bold">
							<span class="border-r border-line p-2.5">Application</span>
							<span class="border-r border-line p-2.5">API</span>
							<span class="p-2.5">Docs</span>
						</div>
					</aside>
				</section>

				<section class="border-b border-line bg-ink px-[clamp(1.25rem,4vw,3.25rem)] py-[clamp(4.5rem,9vw,7rem)] text-white">
					<p class="m-0 max-w-[59rem] text-[clamp(2.3rem,5.2vw,5rem)] leading-[1.01] font-semibold tracking-[-0.062em]">
						Agents changed how work happens.
						<strong class="font-editorial font-normal text-paper-deep">
							Home-first changes where that work belongs.
						</strong>
					</p>
					<p class="mb-0 mt-7 max-w-[43rem] text-sm leading-relaxed text-white/55">
						The agent era needs an ownership and operating paradigm—not another
						Provider configuration scattered through product repositories.
					</p>
				</section>

				<section class="border-b border-line py-[clamp(5.5rem,11vw,9rem)]" id="shift">
					<header class="mb-12 grid gap-8 px-[clamp(1.25rem,4vw,3.25rem)] md:grid-cols-[1.1fr_0.7fr] md:items-end">
						<div>
							<p class="m-0 text-[0.6rem] font-black uppercase tracking-[0.14em] text-copper">
								01 / A new topology
							</p>
							<h2 class="mt-3 mb-0 text-[clamp(2.8rem,6vw,5.4rem)] leading-[0.95] font-black tracking-[-0.065em]">
								Same system.<br />A different owner.
							</h2>
						</div>
						<div>
							<strong class="block text-base">From Target-first to Home-first.</strong>
							<p class="mb-0 mt-2 text-sm leading-relaxed text-muted">
								Hairness does not replace your stack. It reorganizes it around
								an explicit, source-owned Home.
							</p>
						</div>
					</header>
					<ParadigmShift client:visible={{ rootMargin: '240px' }} />
				</section>

				<section class="border-b border-line bg-paper-soft py-[clamp(5.5rem,11vw,9rem)]" id="assets">
					<div class="grid gap-12 px-[clamp(1.25rem,4vw,3.25rem)] lg:grid-cols-[0.75fr_1.15fr] lg:items-center">
						<header>
							<p class="m-0 text-[0.6rem] font-black uppercase tracking-[0.14em] text-copper">
								02 / A higher-level primitive
							</p>
							<h2 class="mt-3 mb-5 text-[clamp(2.8rem,5.5vw,5rem)] leading-[0.95] font-black tracking-[-0.065em]">
								Think in Assets,<br />
								<em class="font-editorial font-normal text-copper">not formats.</em>
							</h2>
							<p class="max-w-[35rem] text-sm leading-relaxed text-muted">
								A Skill describes one way to invoke a capability. An Agentic
								Asset is the reusable source your Home owns—independent of how
								a Provider needs to receive it.
							</p>
							<p class="mt-6 border-l-2 border-copper pl-4 text-xs leading-relaxed text-muted">
								Artifacts remain separate: an Asset is a product
								<strong class="text-ink">for work</strong>; an Artifact is a
								product <strong class="text-ink">of work</strong>.
							</p>
						</header>

						<figure class="v4-grid-paper m-0 border-y border-line-strong p-4 md:p-7">
							<div class="border border-copper/45 bg-paper-soft">
								<header class="flex items-start justify-between gap-4 border-b border-line bg-copper/8 p-4">
									<div>
										<small class="font-mono text-[0.5rem] font-bold uppercase tracking-[0.1em] text-copper">Canonical Home source</small>
										<strong class="mt-1 block text-lg">Agentic Asset</strong>
									</div>
									<code class="font-mono text-[0.55rem] text-muted">assets/review-method/</code>
								</header>
								<div class="grid gap-2 p-4 sm:grid-cols-2">
									<span class="border-l-2 border-copper bg-copper/8 px-3 py-2 text-xs font-semibold">Instructions</span>
									<span class="border-l-2 border-copper bg-copper/8 px-3 py-2 text-xs font-semibold">Examples</span>
									<span class="border-l-2 border-copper bg-copper/8 px-3 py-2 text-xs font-semibold">Conventions</span>
									<span class="border-l-2 border-copper bg-copper/8 px-3 py-2 text-xs font-semibold">Supporting files</span>
								</div>
							</div>
							<div class="grid grid-cols-[1fr_auto_1fr] place-items-center py-3">
								<i class="h-px w-full bg-line-strong"></i>
								<span class="border border-line-strong bg-paper px-3 py-1 font-mono text-[0.5rem] font-bold uppercase tracking-[0.08em] text-muted">
									project
								</span>
								<i class="h-px w-full bg-line-strong"></i>
							</div>
							<div class="grid grid-cols-2 border border-line-strong bg-paper text-center sm:grid-cols-4">
								<div class="border-r border-b border-line p-3 sm:border-b-0"><small class="block font-mono text-[0.48rem] uppercase text-muted">Invocation</small><strong class="text-xs">Skill</strong></div>
								<div class="border-b border-line p-3 sm:border-r sm:border-b-0"><small class="block font-mono text-[0.48rem] uppercase text-muted">Action</small><strong class="text-xs">Command</strong></div>
								<div class="border-r border-line p-3"><small class="block font-mono text-[0.48rem] uppercase text-muted">Role</small><strong class="text-xs">Agent</strong></div>
								<div class="p-3"><small class="block font-mono text-[0.48rem] uppercase text-muted">Context</small><strong class="text-xs">Prompt</strong></div>
							</div>
							<figcaption class="mt-4 text-center font-mono text-[0.54rem] font-bold uppercase tracking-[0.08em] text-muted">
								One owned Asset · many native forms
							</figcaption>
						</figure>
					</div>
				</section>

				<section class="border-b border-line py-[clamp(5rem,10vw,8rem)]">
					<header class="px-[clamp(1.25rem,4vw,3.25rem)]">
						<p class="m-0 text-[0.6rem] font-black uppercase tracking-[0.14em] text-sky">
							The vocabulary follows the ownership
						</p>
						<h2 class="mt-3 mb-10 max-w-[48rem] text-[clamp(2.6rem,5vw,4.5rem)] leading-[0.97] font-black tracking-[-0.06em]">
							Name the stable system above the tools.
						</h2>
					</header>
					<div class="border-t border-line-strong">
						{vocabulary.map(([from, to, meaning], index) => (
							<article class="grid gap-3 border-b border-line px-[clamp(1.25rem,4vw,3.25rem)] py-5 sm:grid-cols-[2rem_0.65fr_2rem_1fr] sm:items-center">
								<span class="font-mono text-[0.55rem] font-bold text-copper">{String(index + 1).padStart(2, '0')}</span>
								<strong class="text-sm text-muted">{from}</strong>
								<i class="not-italic text-line-strong" aria-hidden="true">→</i>
								<div class="flex flex-wrap items-baseline justify-between gap-2">
									<strong class="text-lg tracking-[-0.03em]">{to}</strong>
									<small class="text-[0.6rem] text-muted">{meaning}</small>
								</div>
							</article>
						))}
					</div>
				</section>

				<section class="border-b border-line bg-ink py-[clamp(5.5rem,11vw,9rem)] text-white" id="providers">
					<header class="mb-12 grid gap-8 px-[clamp(1.25rem,4vw,3.25rem)] md:grid-cols-[1.1fr_0.7fr] md:items-end">
						<div>
							<p class="m-0 text-[0.6rem] font-black uppercase tracking-[0.14em] text-paper-deep">
								03 / Maximum portability
							</p>
							<h2 class="mt-3 mb-0 text-[clamp(2.8rem,6vw,5.4rem)] leading-[0.95] font-black tracking-[-0.065em]">
								Provider-native.<br />
								<em class="font-editorial font-normal text-paper-deep">Never Provider-owned.</em>
							</h2>
						</div>
						<p class="m-0 text-sm leading-relaxed text-white/55">
							Keep the native ergonomics of every Provider without making its
							configuration the canonical source of your environment.
						</p>
					</header>
					<div class="text-ink">
						<ProviderProjection client:visible={{ rootMargin: '240px' }} />
					</div>
				</section>

				<section class="border-b border-line py-[clamp(5.5rem,11vw,9rem)]">
					<div class="grid gap-12 px-[clamp(1.25rem,4vw,3.25rem)] lg:grid-cols-[0.75fr_1.15fr] lg:items-center">
						<header>
							<p class="m-0 text-[0.6rem] font-black uppercase tracking-[0.14em] text-copper">
								04 / Independent products
							</p>
							<h2 class="mt-3 mb-5 text-[clamp(2.8rem,5.5vw,5rem)] leading-[0.95] font-black tracking-[-0.065em]">
								Keep product repositories
								<em class="block font-editorial font-normal text-copper">product-owned.</em>
							</h2>
							<p class="max-w-[35rem] text-sm leading-relaxed text-muted">
								A Target owns its code, history, and delivery. It no longer
								needs to become the permanent storage room for every method,
								agent definition, experiment, and working document.
							</p>
						</header>

						<figure class="v4-grid-paper m-0 grid gap-3 border-y border-line-strong p-4 sm:grid-cols-[1fr_3rem_0.85fr] sm:items-center md:p-7">
							<section class="border border-ink bg-paper-soft">
								<header class="flex justify-between gap-4 bg-ink p-3 text-white">
									<strong class="font-mono text-xs">application/</strong>
									<small class="font-mono text-[0.48rem] uppercase tracking-[0.08em] text-white/50">Target</small>
								</header>
								<div class="grid gap-2 p-4 font-mono text-[0.62rem] text-muted">
									<span class="border-l-2 border-line-strong pl-2">src/</span>
									<span class="border-l-2 border-line-strong pl-2">tests/</span>
									<span class="border-l-2 border-line-strong pl-2">docs/</span>
								</div>
								<footer class="border-t border-line px-4 py-2 font-mono text-[0.5rem] uppercase text-muted">
									code · history · delivery
								</footer>
							</section>
							<div class="grid grid-cols-[1fr_auto_1fr] place-items-center sm:grid-cols-1 sm:grid-rows-[1fr_auto_1fr]">
								<i class="h-px w-full bg-line-strong sm:h-full sm:w-px"></i>
								<span class="border border-line-strong bg-paper px-2 py-1 font-mono text-[0.48rem] font-bold uppercase text-muted">Binding</span>
								<i class="h-px w-full bg-line-strong sm:h-full sm:w-px"></i>
							</div>
							<section class="border border-copper/50 bg-paper-soft">
								<header class="bg-copper/8 p-3">
									<small class="font-mono text-[0.48rem] font-bold uppercase tracking-[0.08em] text-copper">Home-owned</small>
									<strong class="mt-1 block">Agentic environment</strong>
								</header>
								<div class="grid gap-2 border-t border-line p-4 text-xs">
									<span>review method</span>
									<span>research agent</span>
									<span>release workflow</span>
									<span class="text-sky">working Artifacts → Desk</span>
								</div>
							</section>
						</figure>
					</div>
				</section>

				<section class="border-b border-line bg-paper-soft py-[clamp(5.5rem,11vw,9rem)]">
					<header class="mb-12 px-[clamp(1.25rem,4vw,3.25rem)]">
						<p class="m-0 text-[0.6rem] font-black uppercase tracking-[0.14em] text-sky">
							05 / A compounding environment
						</p>
						<h2 class="mt-3 mb-5 max-w-[54rem] text-[clamp(2.8rem,6vw,5.4rem)] leading-[0.95] font-black tracking-[-0.065em]">
							Work returns Home as evidence.
						</h2>
						<p class="max-w-[42rem] text-sm leading-relaxed text-muted">
							Agentic work should not disappear into a session or silently
							rewrite the system. It returns as an Artifact for human judgment.
						</p>
					</header>
					<div class="mx-[clamp(1.25rem,4vw,3.25rem)] grid border-y border-line-strong md:grid-cols-[1fr_auto_1fr_auto_1fr_auto_1fr] md:items-stretch">
						<div class="bg-copper/8 p-5"><small class="text-[0.5rem] font-bold uppercase tracking-[0.1em] text-copper">Product for work</small><strong class="mt-1 block text-xl">Asset</strong><p class="mb-0 text-xs text-muted">method · instructions · examples</p></div>
						<i class="grid place-items-center border-y border-line px-3 py-2 not-italic md:border-x md:border-y-0">→</i>
						<div class="bg-paper p-5"><small class="text-[0.5rem] font-bold uppercase tracking-[0.1em] text-muted">Execution</small><strong class="mt-1 block text-xl">Work</strong><p class="mb-0 text-xs text-muted">investigate · create · change</p></div>
						<i class="grid place-items-center border-y border-line px-3 py-2 not-italic md:border-x md:border-y-0">→</i>
						<div class="bg-sky-soft p-5"><small class="text-[0.5rem] font-bold uppercase tracking-[0.1em] text-sky">Product of work</small><strong class="mt-1 block text-xl">Artifact</strong><p class="mb-0 text-xs text-muted">research · review · plan</p></div>
						<i class="grid place-items-center border-y border-line px-3 py-2 not-italic md:border-x md:border-y-0">→</i>
						<div class="bg-ink p-5 text-white"><small class="text-[0.5rem] font-bold uppercase tracking-[0.1em] text-paper-deep">Explicit gate</small><strong class="mt-1 block text-xl">Human judgment</strong><p class="mb-0 text-xs text-white/55">keep evidence or promote deliberately</p></div>
					</div>
					<p class="mx-[clamp(1.25rem,4vw,3.25rem)] mt-6 max-w-[48rem] border-l-2 border-copper pl-4 text-sm leading-relaxed text-muted">
						Only human curation can turn what was learned into a new or better
						Asset. The environment compounds without outsourcing direction.
					</p>
				</section>

				<section class="border-b border-line py-[clamp(5.5rem,11vw,9rem)]" id="collaboration">
					<div class="grid gap-12 px-[clamp(1.25rem,4vw,3.25rem)] lg:grid-cols-[0.75fr_1.15fr] lg:items-center">
						<header>
							<p class="m-0 text-[0.6rem] font-black uppercase tracking-[0.14em] text-copper">
								06 / Human-agent collaboration
							</p>
							<h2 class="mt-3 mb-5 text-[clamp(2.8rem,5.5vw,5rem)] leading-[0.95] font-black tracking-[-0.065em]">
								Share the Home.<br />
								<em class="font-editorial font-normal text-copper">Keep a Desk of your own.</em>
							</h2>
							<p class="max-w-[35rem] text-sm leading-relaxed text-muted">
								The Home owns what collaboration should inherit. Your Desk
								owns private continuity, drafts, working Artifacts, and local
								Bindings.
							</p>
						</header>

						<figure class="v4-grid-paper m-0 border-y border-line-strong p-4 md:p-7">
							<div class="grid gap-3 sm:grid-cols-[0.45fr_1.2fr_0.5fr] sm:items-center">
								<aside class="border border-line-strong bg-paper p-3">
									<small class="font-mono text-[0.48rem] uppercase text-muted">Provider</small>
									<strong class="mt-1 block text-sm">Agent session</strong>
									<span class="mt-3 block font-mono text-[0.52rem] text-muted">Codex · Claude</span>
								</aside>
								<section class="border border-ink bg-paper">
									<header class="flex justify-between gap-3 bg-ink p-3 text-white">
										<div><small class="block font-mono text-[0.46rem] uppercase tracking-[0.08em] text-paper-deep">Shared canon</small><strong>Home</strong></div>
										<span class="font-mono text-[0.48rem] text-white/45">Assets · conventions</span>
									</header>
									<div class="m-3 border border-sky/45 bg-sky-soft p-4">
										<small class="font-mono text-[0.46rem] uppercase tracking-[0.08em] text-sky">Private continuity</small>
										<strong class="mt-1 block">Your Desk</strong>
										<p class="mb-0 mt-3 flex flex-wrap gap-1 text-[0.52rem] text-muted">
											<span class="border border-sky/35 px-2 py-1">drafts</span>
											<span class="border border-sky/35 px-2 py-1">Artifacts</span>
											<span class="border border-sky/35 px-2 py-1">Bindings</span>
										</p>
									</div>
								</section>
								<aside class="border border-line-strong bg-paper p-3">
									<small class="font-mono text-[0.48rem] uppercase text-muted">Binding</small>
									<strong class="mt-1 block text-sm">Target</strong>
									<span class="mt-3 block font-mono text-[0.52rem] text-muted">independent product</span>
								</aside>
							</div>
