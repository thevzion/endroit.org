						<div class="border border-white/30 bg-ink">
							<header class="flex items-center gap-1.5 border-b border-white/15 px-4 py-3">
								<i class="size-2 rounded-full bg-copper"></i>
								<i class="size-2 rounded-full bg-paper-deep"></i>
								<i class="size-2 rounded-full bg-sky"></i>
								<small class="ml-auto font-mono text-[0.5rem] uppercase tracking-[0.1em] text-white/40">create a Home</small>
							</header>
							<div class="flex items-center gap-3 p-4">
								<code class="min-w-0 flex-1 overflow-x-auto font-mono text-[0.63rem] text-paper-deep">{createCommand}</code>
								<button class="border border-white/25 px-3 py-2 text-[0.56rem] font-bold uppercase tracking-[0.08em] hover:bg-white hover:text-ink" type="button" data-v5-copy={createCommand}>
									Copy
