			<footer class="flex flex-wrap items-center justify-between gap-4 border-t border-line bg-paper px-[clamp(1.25rem,4vw,3.25rem)] py-8 text-xs text-muted">
				<strong class="text-ink">hairness</strong>
				<p class="m-0">Own the place where humans and agents build what comes next.</p>
				<a class="font-bold text-ink no-underline" href="/lab/">Iteration lab</a>
			</footer>
		</div>

		<script>
			const copyButton = document.querySelector<HTMLButtonElement>('[data-v5-copy]');
			copyButton?.addEventListener('click', async () => {
				const command = copyButton.dataset.v5Copy;
				if (!command || !navigator.clipboard) return;
				await navigator.clipboard.writeText(command);
				copyButton.textContent = 'Copied';
				window.setTimeout(() => {
					copyButton.textContent = 'Copy';
				}, 1400);
			});
		</script>
