---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	path: string;
}

const { title, description, path } = Astro.props;
const canonical = new URL(path, Astro.site);
const socialCard = new URL('/social-card.png', Astro.site);
const socialAlt = 'Endroit — From intent to verified effect. An architectural Home connected to sovereign Sites.';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f4efe5" />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Endroit" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={socialCard} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={socialAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialCard} />
		<meta name="twitter:image:alt" content={socialAlt} />
		<title>{title}</title>
	</head>
	<body>
		<!--
		THESIS: Endroit recognizes the work already present and connects it through one owned Home; it refuses the generic SaaS hero-and-cards landing.
		OWN-WORLD: Ivory drafting paper, architectural navy, copper routes, Libre Caslon display type and an isometric Home atlas.
		STORY: See existing Sites, recognize a boundary, transpose responsibilities without moving sources, then prove continuity in a fresh session.
		FIRST VIEWPORT: Promise and actions lead on the left; a large connected Home and its sovereign Sites occupy the right, with the primary adoption action above the fold.
		FORM: Architectural atlas, pinned by the accepted social-card authority; seed key pinned-endroit-atlas-2026-08.
		FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
		-->
		<a class="skip-link" href="#content">Skip to content</a>
		<div id="content">
			<slot />
		</div>
	</body>
</html>
