---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Not found | Hairness"
	description="This room does not exist in the Hairness Home."
	path="/404.html"
>
	<SiteHeader />
	<main class="not-found shell">
		<p class="eyebrow">404 · Wrong door</p>
		<h1>This room doesn’t exist.</h1>
		<p>The Home is intact. This route has no Binding.</p>
		<a class="button button-primary" href="/">Return to the Front Door</a>
	</main>
	<SiteFooter />
</BaseLayout>
