---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found | Endroit" description="This address does not resolve inside the Endroit public instrument." path="/404.html">
	<main id="main" class="page-instrument">
		<section class="module not-found-module" aria-labelledby="not-found-title">
			<p class="module-plate">FAULT · 404 / UNRESOLVED ADDRESS</p>
			<div class="fault-code" aria-hidden="true"><span>4</span><i></i><span>0</span><i></i><span>4</span></div>
			<h1 id="not-found-title">No Route reaches this address.</h1>
			<p class="page-lede">The Home is intact. Return to the instrument and resolve a known surface.</p>
			<a class="action action-primary" href="/">Return to the Front Door</a>
		</section>
	</main>
</BaseLayout>
