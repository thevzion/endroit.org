---
import EnvironmentDistrict from '../components/EnvironmentDistrict';
import InstallCommand from '../components/InstallCommand.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const journey = [
	['Create or initialize', 'Start with a human Member and a Desk whose identity and Git boundary are explicit.'],
	['Enter the place', 'Enter the Home or a Room and reload its owned sources without hidden active-Room state.'],
	['Compose the Meeting', 'Call an Occupant, work through a Role or use Equipment through distinct provider-native verbs.'],
	['Choose what remains', 'Keep the result ephemeral, retain it, accept it, deliver it or archive it.'],
	['Maintain the Home', 'Inspect every layer read-only; approve one concrete repair before anything changes.'],
];

const responsibilities = [
	['Home', 'Shared workplace and house rules'],
	['Member', 'One human collaborator and durable responsibilities'],
	['Desk', 'That Member’s local continuity and access'],
	['Room', 'One durable domain and its Material'],
	['Equipment', 'A reusable way of working'],
	['Site', 'A sovereign external owner of truth'],
	['Route', 'Desk-local Git access to a Site'],
];

const siteModes = ['Embedded', 'Managed clone', 'Managed worktree', 'Existing checkout', 'Submodule', 'Remote-only'];
---

<BaseLayout
	title="Endroit — The place layer for agentic work"
	description="A local-first, headless, file-based implementation of the Open Workplace model."
	path="/"
>
	<SiteHeader />
	<main>
		<section class="hero-section">
			<div class="page-shell">
				<p class="eyebrow">The place layer for agentic work.</p>
				<h1 class="mt-7">Give agentic work<br /><span>a place to compound.</span></h1>
				<div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.48fr)] lg:items-end lg:gap-16">
					<div>
						<p class="max-w-3xl text-xl leading-relaxed text-muted md:text-2xl">
							A local-first, headless, file-based implementation of the Open Workplace model.
							It adds ownership, orientation, continuity and destination around the agents and repositories you already use.
						</p>
						<p class="mt-5 max-w-2xl text-base font-semibold text-ink/80">
							Same Material. Human-readable sources. Provider-native interfaces.
						</p>
					</div>
					<div class="flex flex-col gap-3 lg:items-start">
						<a class="primary-cta" href="#install">
							Create a Home
							<svg aria-hidden="true" viewBox="0 0 20 20"><path d="M4 10h11M11 6l4 4-4 4"></path></svg>
						</a>
						<a class="secondary-link" href="https://open-workplace.org/proposal/">
							Read the Workplace-first Proposal <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="mt-12 flex flex-wrap gap-x-6 gap-y-2 border-t border-ink/10 pt-5 font-mono text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-muted">
					<span>Local-first</span>
					<span>Headless</span>
					<span>Git-friendly</span>
					<span class="text-copper-dark">0.8 alpha · actively dogfooded</span>
				</div>
			</div>
		</section>

		<section id="setup" class="border-y border-ink/10 bg-paper-strong section-space">
			<div class="page-shell">
				<div class="max-w-3xl">
					<p class="eyebrow">The setup you already recognize</p>
					<h2 class="section-title">Your agent setup quietly became a workplace.</h2>
					<p class="section-lede">
						It started with an instruction file. Then came preferences, maps, memory, plans,
						decisions, methods, specialized agents and a folder for outputs. Each addition made sense.
						The whole no longer had clear owners.
					</p>
				</div>
				<div class="mt-12 grid gap-5 lg:grid-cols-2">
					<article class="responsibility-panel responsibility-before">
						<p class="eyebrow">A few surfaces, many responsibilities</p>
						<pre><code>AGENTS.md
├── constitution
├── preferences
├── orientation
├── product rules
├── decisions
└── current state

Skills/
├── procedures
├── knowledge
├── methods
├── agents
└── outputs</code></pre>
					</article>
					<article class="responsibility-panel responsibility-after">
						<p class="eyebrow">One owner per responsibility</p>
						<div class="responsibility-list">
							{responsibilities.map(([name, copy]) => <div><strong>{name}</strong><span>{copy}</span></div>)}
						</div>
					</article>
				</div>
				<p class="mt-8 text-2xl font-semibold tracking-[-0.035em]">The pieces were already there. They just needed a place.</p>
			</div>
		</section>

		<section id="workplace-first" class="bg-night py-20 text-paper-strong md:py-28 lg:py-36">
			<div class="district-shell">
				<div class="mb-12 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.45fr)] lg:items-end lg:gap-16">
					<div>
						<p class="eyebrow eyebrow-dark">Prompt-centric · Agent-centric · Workplace-first</p>
						<h2 class="max-w-4xl text-balance text-4xl font-semibold tracking-[-0.055em] md:text-6xl lg:text-7xl">
							Make the workplace first-class.
						</h2>
					</div>
					<p class="m-0 text-base leading-relaxed text-paper/60 md:text-lg">
						Prompt-centric and Agent-centric name useful centers of attention, not rival
						paradigms or a historical sequence. Workplace-first makes the place first-class.
					</p>
				</div>
				<EnvironmentDistrict client:visible />
				<noscript>
					<div class="mt-5 rounded-2xl border border-white/15 bg-white/[0.04] p-5 text-sm leading-relaxed text-paper/70">
						<strong class="text-paper-strong">Agent-centric design equips the occupant. Workplace-first equips the place.</strong>
						 Home, Desk, Room, Equipment, Site and Route give durable responsibilities explicit owners before provider projections are built.
					</div>
				</noscript>
			</div>
		</section>

		<section id="experience" class="section-space">
			<div class="page-shell">
				<div class="max-w-3xl">
					<p class="eyebrow">The experience</p>
					<h2 class="section-title">Enter the place. Complete the work.</h2>
					<p class="section-lede">The Meeting can change. The owned environment carries what should remain.</p>
				</div>
				<pre class="source-tree mt-8"><code>create/init → enter → call/work-as/use
            → retain → accept → work-on/deliver
            → maintain-the-home</code></pre>
				<div class="capital-grid">
					{journey.map(([title, copy], index) => (
						<article><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{copy}</p></article>
					))}
				</div>
				<p class="claim-note">Endroit doesn’t make the agent smarter. It makes the situation clearer.</p>
			</div>
		</section>

		<section id="material" class="border-y border-ink/10 bg-paper-strong section-space">
			<div class="page-shell grid gap-12 lg:grid-cols-2 lg:gap-20">
				<div>
					<p class="eyebrow">Shared matter</p>
					<h2 class="section-title">Touch the same Material as your agents.</h2>
					<p class="section-lede">
						Endroit’s sources are ordinary local files. Humans read and edit them directly.
						Agents receive deterministic projections for their provider. The interface can change without moving ownership into it.
					</p>
				</div>
				<div class="plain-contract">
					<p>Owned sources</p>
					<span>Human-readable documents</span>
					<span>Provider front doors</span>
					<span>Optional live orientation</span>
					<span>Explicit Git Routes</span>
					<strong>No persistent agent, daemon or SaaS is required.</strong>
				</div>
			</div>
		</section>

		<section id="sites" class="section-space">
			<div class="page-shell">
				<div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.5fr)] lg:gap-20">
					<div>
						<p class="eyebrow">Sites and Routes</p>
						<h2 class="section-title">Repositories keep their sovereignty.</h2>
						<p class="section-lede">
							A Site owns external truth. In Endroit 0.8, a Route records Desk-local Git access.
							A remote-only Site has no Route; non-Git access remains future work.
							Physical containment never erases a repository’s Git history, permissions or delivery lifecycle.
						</p>
						<p class="mt-7 text-lg font-semibold">A Site is not a symlink. A symlink can only be a disposable local view.</p>
					</div>
					<div class="mode-list">
						{siteModes.map((mode, index) => <div><span>{String(index + 1).padStart(2, '0')}</span><strong>{mode}</strong></div>)}
					</div>
				</div>
			</div>
		</section>

		<section id="install" class="border-y border-ink/10 bg-paper-strong section-space">
			<div class="page-shell">
				<div class="grid gap-12 lg:grid-cols-[minmax(0,0.62fr)_minmax(0,1fr)] lg:items-center lg:gap-20">
					<div>
						<p class="eyebrow">A small framework</p>
						<h2 class="section-title">Start with a Member, a Desk and one Room.</h2>
						<p class="section-lede">
							A new Home starts with settings, house rules, one human Member, one Room and one Desk. The Member is not an agent;
							the Desk identifies a local place, not the person. Provider front doors are generated, and inspectable bootstrap
							Equipment provide onboarding, orientation, Artifacts, Rooms, Sites and Home Hygiene.
							Additional Rooms, Sites and optional Equipment appear only when the work needs them.
						</p>
						<p class="mt-6 text-sm font-semibold">Requires Git and Node.js 22 or newer. Codex and Claude are the first qualified providers; unsupported provider actions return blocked.</p>
						<p class="mt-5 font-mono text-sm"><code>npx @endroit/cli init</code> adds a Home to an existing repository with a separate local Desk by default. <code>--desk tracked|separate|later</code> overrides that boundary.</p>
					</div>
					<InstallCommand />
				</div>
			</div>
		</section>

		<section id="framework" class="section-space">
			<div class="page-shell grid gap-12 lg:grid-cols-2 lg:gap-20">
				<article>
					<p class="eyebrow">Core and Equipment</p>
					<h2 class="mt-5 text-4xl font-semibold leading-[0.98] tracking-[-0.055em] md:text-5xl">The framework implements the workplace. Equipment owns the method.</h2>
					<p class="section-lede">
						Core resolves ownership, validates structure, builds projections and manages safe Routes.
						First-party Home Hygiene composes those existing checks into one read-only inspection. Optional Equipment
						adds research, planning, publishing or your own way of working.
					</p>
				</article>
				<article>
					<p class="eyebrow">Optional companion</p>
					<h2 class="mt-5 text-4xl font-semibold leading-[0.98] tracking-[-0.055em] md:text-5xl">The workplace needs nouns. Humans need verbs.</h2>
					<p class="section-lede">
						Endroit 0.8 projects human verbs such as <code>call-the-researcher</code>, <code>work-as-an-engineer</code>,
						<code>use-research</code>, <code>retain-this</code> and <code>deliver-this</code>. HACP can compose explicit
						controls around those moves, but remains an independent draft protocol rather than an Endroit prerequisite.
					</p>
					<a class="secondary-link" href="https://github.com/control-decks/human-agent-control-protocol">Read about HACP ↗</a>
				</article>
			</div>
		</section>

		<section id="boundaries" class="bg-night py-20 text-paper-strong md:py-28">
			<div class="page-shell grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.52fr)] lg:gap-20">
				<div>
					<p class="eyebrow eyebrow-dark">Usable today. Still evolving.</p>
					<h2 class="mt-5 max-w-3xl text-5xl font-semibold leading-[0.95] tracking-[-0.06em] md:text-7xl">Give agentic work a place to compound.</h2>
					<div class="mt-8 flex flex-wrap gap-4">
						<a class="primary-cta" href="#install">Create a Home</a>
						<a class="secondary-link text-paper-strong" href="https://github.com/thevzion/endroit">View on GitHub ↗</a>
					</div>
				</div>
				<aside class="alpha-panel alpha-panel-dark">
					<p class="eyebrow eyebrow-dark">Alpha boundaries</p>
					<ul>
						<li>Codex and Claude are the first qualified projections.</li>
						<li>The 0.8 workplace grammar is a breaking alpha change.</li>
						<li>Submodules are recognized; their lifecycle is not managed.</li>
						<li>Home Hygiene advises and inspects; it never repairs, archives, delivers or pushes implicitly.</li>
						<li>Presence, live titles and adaptive workplace behavior remain later work.</li>
						<li>Open Workplace is an open proposal, not a standard, foundation or required service.</li>
						<li>HACP is an independent, optional draft protocol.</li>
						<li>No claim of better intelligence, fewer hallucinations, lower costs or higher productivity.</li>
					</ul>
				</aside>
			</div>
		</section>
	</main>
	<SiteFooter />
</BaseLayout>
