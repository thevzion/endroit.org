---
import { compiledContent } from '../content/endroit-landing.md';
import AdoptionMap from '../components/AdoptionMap.astro';
import FreshSessionProof from '../components/FreshSessionProof.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import StaticFoundation from '../components/StaticFoundation.astro';
import WorkplaceHero from '../components/WorkplaceHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const html = await compiledContent();

const heading = (level: 2 | 3, id: string) => `<h${level} id="${id}">`;
const take = (start: string | null, end: string | null) => {
	const startIndex = start ? html.indexOf(start) : 0;
	const endIndex = end ? html.indexOf(end) : html.length;
	if (startIndex < 0 || endIndex < 0 || startIndex >= endIndex) {
		throw new Error(`Endroit landing projection boundary is missing or out of order: ${start ?? 'start'} → ${end ?? 'end'}`);
	}
	return html.slice(startIndex, endIndex);
};
const normalizeActions = (value: string) => value.replace(/<\/a>\s*·\s*<a/g, '</a><a');
const normalizeHero = (value: string) => normalizeActions(value)
	.replace('<blockquote>', '<div class="hero-proposition">')
	.replace('</blockquote>', '</div>');

const ids = {
	hero: 'from-intent-to-verified-effect',
	paths: 'two-ways-in',
	bring: 'bring-what-you-have',
	fresh: 'start-fresh',
	before: 'before-the-pieces-are-already-there',
	recognize: 'recognize-choose-the-right-boundary',
	transpose: 'nothing-moved-responsibilities-became-explicit',
	prove: 'prove-it-in-a-fresh-session',
	static: 'static-core-optional-runtime',
	daily: 'work-this-way-every-day',
	ownership: 'what-owns-what',
	install: 'install-the-foundation',
	alpha: 'alpha-boundaries',
	final: 'engineer-the-path-from-intent-to-verified-effect',
} as const;
---

<BaseLayout
	title="Endroit — From intent to verified effect."
	description="The place layer for Workplace-first software engineering: resolved for agents, readable by humans and versioned with Git."
	path="/"
>
	<SiteHeader />
	<main class="endroit-landing">
		<WorkplaceHero
			heroHtml={normalizeHero(take(null, heading(2, ids.paths)))}
			pathsIntroHtml={take(heading(2, ids.paths), heading(3, ids.bring))}
			bringHtml={take(heading(3, ids.bring), heading(3, ids.fresh))}
			freshHtml={take(heading(3, ids.fresh), heading(2, ids.before))}
			beforeHtml={take(heading(2, ids.before), heading(2, ids.recognize))}
		/>
		<AdoptionMap
			recognizeHtml={take(heading(2, ids.recognize), heading(2, ids.transpose))}
			transposeHtml={take(heading(2, ids.transpose), heading(2, ids.prove))}
		/>
		<FreshSessionProof proofHtml={take(heading(2, ids.prove), heading(2, ids.static))} />
		<StaticFoundation
			staticHtml={take(heading(2, ids.static), heading(2, ids.daily))}
			dailyHtml={take(heading(2, ids.daily), heading(2, ids.ownership))}
			ownershipHtml={take(heading(2, ids.ownership), heading(2, ids.install))}
			installHtml={take(heading(2, ids.install), heading(2, ids.alpha))}
			alphaHtml={take(heading(2, ids.alpha), heading(2, ids.final))}
			finalHtml={normalizeActions(take(heading(2, ids.final), null))}
		/>
	</main>
	<SiteFooter />
</BaseLayout>

<style is:global>
	@font-face {
		font-family: "Libre Caslon Display";
		font-style: normal;
		font-weight: 400;
		font-display: swap;
		src: url("/fonts/libre-caslon-display-latin-400-normal.woff2") format("woff2");
	}

	body:has(main.endroit-landing) .nav-cta {
		display: none;
	}

	.endroit-landing {
		--atlas-blue: #0b2b4d;
		--atlas-blue-soft: #173f63;
		--atlas-copper: #a9512f;
		--atlas-copper-bright: #d17543;
		--atlas-ivory: #f6f0e5;
		--atlas-rule: rgb(11 43 77 / 18%);
		--atlas-copy: min(70ch, 100%);
		overflow: clip;
		background: var(--atlas-ivory);
	}

	.endroit-landing h1,
	.endroit-landing h2,
	.endroit-landing h3,
	.endroit-landing p,
	.endroit-landing ul,
	.endroit-landing ol,
	.endroit-landing pre {
		margin-top: 0;
	}

	.endroit-landing h1,
	.endroit-landing h2,
	.endroit-landing h3 {
		font-family: "Libre Caslon Display", Georgia, serif;
		font-weight: 400;
		letter-spacing: -0.025em;
	}

	.endroit-landing h2 {
		max-width: 17ch;
		margin-bottom: 1.35rem;
		font-size: clamp(2.65rem, 5.8vw, 5.8rem);
		line-height: 0.96;
	}

	.endroit-landing h3 {
		font-size: clamp(1.75rem, 3vw, 2.75rem);
		line-height: 1;
	}

	.endroit-landing p,
	.endroit-landing li {
		max-width: var(--atlas-copy);
		font-size: clamp(1rem, 1.2vw, 1.12rem);
		line-height: 1.7;
	}

	.endroit-landing a {
		font-weight: 760;
		text-underline-offset: 0.22em;
	}

	.endroit-landing pre {
		max-width: 100%;
		overflow-x: auto;
		font-size: clamp(0.78rem, 1.05vw, 0.9rem);
		line-height: 1.72;
	}

	.endroit-landing summary {
		cursor: pointer;
	}

	.endroit-landing [id] {
		scroll-margin-top: 9rem;
	}

	@media (max-width: 480px) {
		.endroit-landing h2 {
			font-size: clamp(2.35rem, 11vw, 3.65rem);
		}

		.endroit-landing [id] {
			scroll-margin-top: 5.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.endroit-landing *,
		.endroit-landing *::before,
		.endroit-landing *::after {
			scroll-behavior: auto !important;
			animation-duration: 0.001ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.001ms !important;
		}
	}
</style>
