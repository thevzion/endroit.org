---
import { Image } from 'astro:assets';
import HomeFlow from '../components/HomeFlow.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import homeFirstJourney from '../assets/hairness-home-first-journey.webp';

const createCommand = 'npx --yes @hairness/cli@latest create my-home';
---

<BaseLayout
	title="Hairness | Own the place where your agents work"
	description="Hairness is an open, Home-first framework for building source-owned agent work environments across providers and repositories."
	path="/"
>
	<SiteHeader />
	<main>
		<section class="hero shell">
			<div class="hero-copy">
				<p class="eyebrow">The ownership layer for agentic work.</p>
				<h1>Own the place where your agents work.</h1>
				<p class="hero-lede">
					Hairness is an open, Home-first framework for building source-owned
					agent work environments across providers and repositories.
				</p>
				<div class="hero-actions">
					<a class="button button-primary" href="#create-home">Create your Home</a>
					<a class="button button-secondary" href="/home-first/">Explore Home-first</a>
				</div>
				<p class="proof-line">
					<span>Codex and Claude today</span>
					<span aria-hidden="true">·</span>
					<span>Hairness 0.5 alpha</span>
				</p>
			</div>

			<div class="hero-card" id="create-home">
				<div class="terminal-bar" aria-hidden="true">
					<span></span><span></span><span></span>
					<p>create a Home</p>
				</div>
				<div class="command-row">
					<code>{createCommand}</code>
					<button class="copy-button" type="button" data-copy={createCommand}>
						Copy
					</button>
				</div>
				<p>Own one environment across your existing agents and repositories.</p>
			</div>
		</section>

		<section class="section shell section-flow" aria-labelledby="flow-title">
			<div class="section-heading">
				<p class="eyebrow">Home-first by design</p>
				<h2 id="flow-title">The agent enters a Home before it reaches a repository.</h2>
				<p>
					The provider hosts the session. The Home owns orientation,
					capabilities and continuity. Bindings keep every Target independent.
				</p>
			</div>
			<HomeFlow />
		</section>

		<section class="section section-dark">
			<div class="shell split-story">
				<div>
					<p class="eyebrow eyebrow-light">The accidental default</p>
					<h2>Your repository is not your agent’s Home.</h2>
				</div>
				<div class="story-copy">
					<p>
						Open an agent in three repositories and you quietly create three
						different environments. Context is rebuilt, methods are copied and
						useful outcomes disappear into sessions.
					</p>
					<p>
						Hairness moves that environment beside your repositories. A Target
						is where the agent works. It should not own how the agent works.
					</p>
					<a class="text-link text-link-light" href="/home-first/">
						See the Home-first shift <span aria-hidden="true">→</span>
					</a>
				</div>
			</div>
		</section>

		<section class="section shell proof-section" aria-labelledby="proof-title">
			<div class="section-heading">
				<p class="eyebrow">Already real</p>
				<h2 id="proof-title">An environment you can inspect, version and keep.</h2>
			</div>
			<div class="proof-grid">
				<article>
					<span class="number">01</span>
					<h3>Home + Desk</h3>
					<p>Shared orientation and private continuity have distinct owners.</p>
				</article>
				<article>
					<span class="number">02</span>
					<h3>Assets + Artifacts</h3>
					<p>Products for work stay separate from the products of work.</p>
				</article>
				<article>
					<span class="number">03</span>
					<h3>Bindings + Targets</h3>
					<p>Operate repositories without filling them with agent infrastructure.</p>
				</article>
				<article>
					<span class="number">04</span>
					<h3>Replaceable providers</h3>
					<p>Codex and Claude enter through projections rebuilt from owned sources.</p>
				</article>
			</div>
			<figure class="journey-figure">
				<Image
					src={homeFirstJourney}
					alt="Nine illustrated stages show isolated agent work in repositories becoming a source-owned Home with a Front Door, Desks, Assets, Artifacts, independent Targets and accumulated agentic capital."
					widths={[720, 1200, 1800]}
					sizes="(max-width: 760px) 94vw, 1200px"
					loading="lazy"
				/>
				<figcaption>
					Ness is the recurring character in Hairness illustrations, the first
					agent to get a Home. Hairness works with the agent you already use.
				</figcaption>
			</figure>
		</section>

		<section class="section concept-section">
			<div class="shell">
				<div class="section-heading section-heading-wide">
					<p class="eyebrow">Think in Homes, not skill bundles</p>
					<h2>What would your Home be built for?</h2>
					<p>
						A Home can organize a domain, a role or a team. These examples are
						thought experiments, not products pretending to be finished.
					</p>
				</div>
				<div class="concept-grid">
					<article>
						<p class="concept-status">Concept · Not installable yet</p>
						<h3>Game Development Home</h3>
						<p>Engine conventions, design decisions, playtest Artifacts and independent game Targets.</p>
					</article>
					<article>
						<p class="concept-status">Concept · Not installable yet</p>
						<h3>Designer Home</h3>
						<p>Research, critique practices, visual systems and durable decisions across client work.</p>
					</article>
					<article>
						<p class="concept-status">Concept · Not installable yet</p>
						<h3>Research Home</h3>
						<p>Evidence standards, reading methods, claims and governed outputs across changing tools.</p>
					</article>
				</div>
				<div class="center-action">
					<a class="button button-secondary" href="/homes/">Imagine your Home</a>
				</div>
			</div>
		</section>

		<section class="section shell alpha-section">
			<div class="alpha-card">
				<div>
					<p class="eyebrow">Hairness 0.5 alpha</p>
					<h2>Use the framework today and help shape the ecosystem.</h2>
				</div>
				<div>
					<p>
						Create a dedicated Home repository, inspect every Asset runtime
						before trusting it and keep product repositories independent.
					</p>
					<div class="hero-actions">
						<a class="button button-primary" href="#create-home">Create your Home</a>
						<a class="text-link" href="https://github.com/thevzion/hairness">
							View Hairness on GitHub <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
	<SiteFooter />
</BaseLayout>

<script>
	const copyButton = document.querySelector<HTMLButtonElement>('[data-copy]');

	copyButton?.addEventListener('click', async () => {
		const command = copyButton.dataset.copy;
		if (!command || !navigator.clipboard) return;

		await navigator.clipboard.writeText(command);
		copyButton.textContent = 'Copied';
		window.setTimeout(() => {
			copyButton.textContent = 'Copy';
		}, 1600);
	});
</script>
