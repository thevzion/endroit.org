---
import CalTag from '../components/CalTag.astro';
import {
	availability,
	capitalDefinition,
	externalLinks,
	intents,
	latchPhases,
	modules,
	relations,
	signalTypes,
	spine,
} from '../lib/instrument.mjs';
import { publicSurface } from '../lib/surface.mjs';
import '../styles/global.css';

const module = Object.fromEntries(modules.map((item) => [item.id, item]));
const { hero, problem, resolver, capital, relations: relationsCopy, craft, stack, availability: availabilityCopy, community } = publicSurface;
void externalLinks;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Endroit gives human-agent work typed context, durable continuity, and an owned place to compound across sessions and repositories."
		/>
		<link rel="canonical" href="https://endroit.org/" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#d9dbd4" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Endroit" />
		<meta property="og:title" content="Endroit · Agents produce. Your workplace compounds." />
		<meta property="og:description" content="Context that knows its place. The next agent starts ahead, not over." />
		<meta property="og:url" content="https://endroit.org/" />
		<meta property="og:image" content="https://endroit.org/social-card.png" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Endroit — Agents produce. Your workplace compounds." />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Endroit · Agents produce. Your workplace compounds." />
		<meta name="twitter:description" content="Context that knows its place. The next agent starts ahead, not over." />
		<meta name="twitter:image" content="https://endroit.org/social-card.png" />
		<meta name="twitter:image:alt" content="Endroit — Agents produce. Your workplace compounds." />
		<script is:inline type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'WebSite',
			name: 'Endroit',
			url: 'https://endroit.org/',
			description: 'The Workplace-first application framework.',
			publisher: { '@type': 'Organization', name: 'The VZion', url: 'https://thevzion.com/' },
		})} />
		<title>Endroit · Agents produce. Your workplace compounds.</title>
	</head>
	<body>
		<!--
		THESIS: Agents produce, the workplace compounds; this production landing is a bench instrument that proves typed context and the capital latch, refusing dark dev-tool theater and feature grids.
		OWN-WORLD: Bench logic-analyzer: warm steel bezel, silkscreen labels, dark graticule screens as bounded inserts, phosphor-green traces, amber trigger accents, red exclusion markers, mono readouts.
		STORY: An engineer sees the restart trace, arms an intent and watches context resolve with visible exclusions, runs the latch sequence, meets the name agentic capital only after experiencing it, then installs.
		FIRST VIEWPORT: Silkscreen title block left (category signal, spine, promise); right, one screen with two traces: agent bursts decaying, workplace staircase holding. Primary action: Run the proof.
		FORM: Oscilloscope and logic-analyzer bench instrument · pinned Endroit 024 world · seed 35010d6f.
		FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
		-->
		<a class="skip-link" href="#main">Skip to the bench</a>

		<header class="bench-bar">
			<a class="brand" href="/" aria-label="Endroit home">endroit</a>
			<nav aria-label="Modules">
				<a href="#problem">The problem</a>
				<a href="#resolver">The resolver</a>
				<a href="#capital">The proof</a>
				<a href="#availability">Availability</a>
			</nav>
			<div class="bar-tools">
				<button type="button" class="cal-toggle" data-cal-toggle aria-pressed="false" hidden>CAL</button>
				<a class="bar-install" href="/install/">Install</a>
			</div>
		</header>

		<main id="main">
			<!-- MODULE 1 · HERO -->
			<section class="module module-hero" aria-labelledby="hero-title">
				<div class="hero-plate">
					<p class="silkscreen-category">{spine.category}</p>
					<h1 id="hero-title">{hero.title}</h1>
					<p class="hero-promise">{hero.punch}</p>
					<p class="hero-lede">{hero.intro}</p>
					<div class="hero-actions">
						{hero.actions.map((action, index) => <a class:list={['action', { 'action-primary': index === 0 }]} href={action.href}>{action.label}</a>)}
					</div>
					<p class="hero-meta">
						Published package <code>0.8.0-alpha.1</code> · Qualified local candidate <code>0.10.0-alpha.0</code> ·
						not yet published or deployed
					</p>
				</div>

				<figure class="screen hero-screen" aria-labelledby="hero-screen-caption">
					<div class="screen-face" aria-hidden="true">
						<div class="trace-row">
							<p class="trace-label">AGENT SESSIONS</p>
							<div class="trace trace-agent">
								<span class="seg low w1"></span><span class="seg high w2"></span><span class="seg low w1"></span>
								<span class="seg high w2"></span><span class="seg low w1"></span><span class="seg high w2"></span>
								<span class="seg low w1"></span>
							</div>
						</div>
						<div class="trace-row">
							<p class="trace-label">YOUR WORKPLACE</p>
							<div class="trace trace-workplace">
								<span class="seg step-0 w3"></span><span class="seg step-1 w3"></span><span class="seg step-2 w3"></span>
								<span class="seg step-3 w3"></span>
							</div>
						</div>
					</div>
					<figcaption id="hero-screen-caption">
						Two signals, one difference: sessions return to zero; the Workplace holds what you decided to keep.
					</figcaption>
				</figure>
				<CalTag module={module.hero} />
			</section>

			<!-- MODULE 2 · PROBLEM -->
			<section class="module" id="problem" aria-labelledby="problem-title">
				<p class="module-plate">MODULE · THE PROBLEM</p>
				<h2 id="problem-title">{problem.title}</h2>
				<div class="module-body">
					<div class="module-copy">
						<p>{problem.intro}</p>
						<p class="module-punch">{problem.punch}</p>
					</div>
					<figure class="screen" aria-labelledby="restart-caption">
						<div class="screen-face" aria-hidden="true">
							<div class="trace-row">
								<p class="trace-label">SESSION 1</p>
								<div class="trace"><span class="seg ramp w4"></span><span class="seg drop w1"></span><span class="seg low w4"></span></div>
							</div>
							<div class="trace-row">
								<p class="trace-label">SESSION 2</p>
								<div class="trace"><span class="seg low w2"></span><span class="seg ramp w4"></span><span class="seg drop w1"></span><span class="seg low w2"></span></div>
							</div>
							<div class="trace-row">
								<p class="trace-label">SESSION 3</p>
								<div class="trace"><span class="seg low w4"></span><span class="seg ramp w4"></span><span class="seg drop w1"></span></div>
							</div>
						</div>
						<figcaption id="restart-caption">The restart trace: three sessions, three warm-ups, nothing carried.</figcaption>
					</figure>
				</div>
				<CalTag module={module.problem} />
			</section>

			<!-- MODULE 3 · RESOLVER -->
			<section class="module" id="resolver" aria-labelledby="resolver-title">
				<p class="module-plate">MODULE · THE RESOLVER</p>
				<h2 id="resolver-title">{resolver.title}</h2>
				<p class="module-lede">{resolver.intro}</p>

				<dl class="type-table">
					{signalTypes.map((entry) => (
						<div>
							<dt>{entry.not}</dt>
							<dd><span class="preserves">{entry.preserves}</span> {entry.detail}</dd>
						</div>
					))}
				</dl>

				<div class="resolver" data-resolver>
					<div class="resolver-rail" data-resolver-rail hidden>
						<p class="rail-label" id="resolver-rail-label">Trigger · your intent</p>
						<div class="rail-list" role="tablist" aria-labelledby="resolver-rail-label"></div>
					</div>

					<div class="resolver-panels">
						{intents.map((intent) => (
							<article class="capture" data-capture id={`capture-${intent.id}`} aria-labelledby={`capture-${intent.id}-title`}>
								<header class="capture-head">
									<h3 id={`capture-${intent.id}-title`}>“{intent.label}”</h3>
									<p class="capture-readout">IN {intent.armed.length} · OUT {intent.excluded.length} · smallest relevant composition</p>
								</header>
								<ul class="channel-list">
									{intent.armed.map((line) => (
										<li class={`channel channel-armed channel-${line.kind}`}>
											<span class="channel-name">{line.channel}</span>
											<span class="channel-trace" aria-hidden="true"></span>
											<span class="channel-note">{line.note}</span>
										</li>
									))}
									{intent.excluded.map((line) => (
										<li class="channel channel-excluded">
											<span class="channel-name">{line.channel}</span>
											<span class="channel-trace" aria-hidden="true"></span>
											<span class="channel-note">excluded · {line.reason}</span>
										</li>
									))}
								</ul>
							</article>
						))}
					</div>
				</div>

				<p class="module-punch">{resolver.punch}</p>
				<p class="module-note">
					Resolution reduces environmental ambiguity by design. It is not a measured claim about model intelligence
					or accuracy, and it does not remove the need for human correction.
				</p>
				<CalTag module={module.resolver} />
			</section>

			<!-- MODULE 4 · CAPITAL -->
			<section class="module" id="capital" aria-labelledby="capital-title">
				<p class="module-plate">MODULE · THE PROOF</p>
				<h2 id="capital-title">{capital.title}</h2>
				<p class="module-lede">{capital.intro}</p>

				<div class="latch" data-latch data-phase="0">
					<figure class="screen latch-screen">
						<div class="screen-face">
							<div class="trace-row" data-channel="occ1">
								<p class="trace-label">OCCUPANT 1 · claude</p>
								<div class="trace">
									<span class="seg high w3" data-ph="0"></span><span class="seg high w3" data-ph="1"></span>
									<span class="seg drop w1" data-ph="2"></span><span class="seg low w2" data-ph="2"></span>
									<span class="seg low w3" data-ph="3"></span>
								</div>
							</div>
							<div class="trace-row" data-channel="material">
								<p class="trace-label">ROOM · payments / Material</p>
								<div class="trace">
									<span class="seg low w3" data-ph="0"></span><span class="seg latch w3" data-ph="1"></span>
									<span class="seg latch w3" data-ph="2"></span><span class="seg latch w3" data-ph="3"></span>
								</div>
							</div>
							<div class="trace-row" data-channel="occ2">
								<p class="trace-label">OCCUPANT 2 · codex</p>
								<div class="trace">
									<span class="seg low w3" data-ph="0"></span><span class="seg low w3" data-ph="1"></span>
									<span class="seg low w3" data-ph="2"></span><span class="seg high w3" data-ph="3"></span>
								</div>
							</div>
						</div>
						<figcaption class="latch-status" data-latch-status aria-live="polite">
							{latchPhases[0].title} — {latchPhases[0].note}
						</figcaption>
					</figure>

					<ol class="latch-phases">
						{latchPhases.map((phase, index) => (
							<li class="latch-phase" data-latch-phase={index}>
								<p class="phase-control">
									{index === 0 ? (
										<span class="phase-start">{phase.control}</span>
									) : (
										<button type="button" class="phase-button" data-latch-control={index} disabled={index !== 1}>
											{phase.control}
										</button>
									)}
								</p>
								<div class="phase-text">
									<h3>{phase.title}</h3>
									<p>{phase.note}</p>
								</div>
							</li>
						))}
					</ol>
					<p class="latch-reset"><button type="button" class="reset-button" data-latch-reset hidden>Reset the capture</button></p>
				</div>

				<aside class="capital-reveal" data-capital-reveal aria-labelledby="capital-reveal-title">
					<h3 id="capital-reveal-title">{capitalDefinition.reveal}</h3>
					<p>{capitalDefinition.meaning}</p>
					<p class="reveal-isnot-head">It is not:</p>
					<ul class="reveal-isnot">
						{capitalDefinition.isNot.map((item) => (
							<li>{item}</li>
						))}
					</ul>
					<p class="module-punch">{capitalDefinition.honest}</p>
				</aside>
				<CalTag module={module.capital} />
			</section>

			<!-- MODULE 5 · RELATIONS -->
			<section class="module" aria-labelledby="relations-title">
				<p class="module-plate">MODULE · THE LEGEND</p>
				<h2 id="relations-title">{relationsCopy.title}</h2>
				<dl class="legend">
					{relations.map((relation) => (
						<div>
							<dt>{relation.name}</dt>
							<dd>{relation.behavior}</dd>
						</div>
					))}
				</dl>
				<p class="module-note">{relationsCopy.intro}</p>
				<CalTag module={module.relations} />
			</section>

			<!-- MODULE 6 · CRAFT -->
			<section class="module module-craft" aria-labelledby="craft-title">
				<p class="module-plate">MODULE · THE CRAFT</p>
				<h2 id="craft-title">{craft.title}</h2>
				<p class="craft-copy">{craft.intro}</p>
				<p class="module-punch">{craft.punch}</p>
				<CalTag module={module.craft} />
			</section>

			<!-- MODULE 7 · STACK -->
			<section class="module" aria-labelledby="stack-title">
				<p class="module-plate">MODULE · THE GRAMMAR</p>
				<h2 id="stack-title">{stack.title}</h2>
				<div class="module-body">
					<ol class="stack-rows">
						<li><strong>Workplace-first</strong><span>the paradigm</span></li>
						<li><strong>Open Workplace</strong><span>the shared model · experimental protocol · independent</span></li>
						<li class="stack-here"><strong>Endroit</strong><span>the application framework</span></li>
						<li><strong>Your Workplace</strong><span>the durable result</span></li>
					</ol>
					<div class="module-copy">
						<p>{stack.intro}</p>
						<p class="stack-links">
							<a href="https://open-workplace.org/proposal/">Read the proposal</a>
							<a href="https://open-workplace.org/protocol/">Read the protocol</a>
							<a href="/profile.md">Inspect the candidate Profile</a>
							<a href="https://github.com/open-workplace/open-workplace">View the Open Workplace source</a>
						</p>
					</div>
				</div>
				<CalTag module={module.stack} />
			</section>

			<!-- MODULE 8 · AVAILABILITY -->
			<section class="module" id="availability" aria-labelledby="availability-title">
				<p class="module-plate">MODULE · CONDITION</p>
				<h2 id="availability-title">{availabilityCopy.title}</h2>
				<ul class="condition-row">
					{availability.map((item) => (
						<li class={`condition condition-${item.state}`}>
							<p class="condition-state">{item.state}</p>
							<h3>{item.label}</h3>
							<p>{item.detail}</p>
						</li>
					))}
				</ul>
				<div class="closing">
					<p class="closing-line">{spine.action}</p>
					<div class="hero-actions">
						<a class="action action-primary" href="/install/">Install Endroit</a>
						<a class="action" href="https://github.com/thevzion/endroit">View the source</a>
						<a class="action" href="/roadmap/">Read the roadmap</a>
					</div>
				</div>
				<CalTag module={module.availability} />
			</section>

			<!-- MODULE 9 · COMMUNITY -->
			<section class="module" id="community" aria-labelledby="community-title">
				<p class="module-plate">MODULE · COMMUNITY</p>
				<h2 id="community-title">{community.title}</h2>
				<p class="module-lede">{community.intro}</p>
				<div class="hero-actions">
					{community.actions.map((action) => <a class="action action-primary" href={action.href}>{action.label}</a>)}
				</div>
				<CalTag module={module.community} />
			</section>
		</main>

		<footer class="bench-foot">
			<p>
				Category on file: <strong>{spine.accepted}</strong> (accepted). The headline spine on this page is candidate
				copy under evaluation on this surface. Every module carries a calibration tag: open any of them, press
				<kbd>Alt</kbd>+<kbd>I</kbd>, or use the CAL switch. The Site-owned <code>SURFACE.md</code> carries the
				public composition and copy; Astro keeps the renderer and visual system.
			</p>
			<p>
				Endroit implements <a href="https://open-workplace.org/">Open Workplace</a> ·
				<a href="https://github.com/thevzion/endroit">source</a> · <a href="/roadmap/">roadmap</a> · MIT licensed
			</p>
		</footer>

		<script>
			// The resolver: three captures exist in document order; JavaScript adds
			// the intent trigger rail over them.
			const resolver = document.querySelector('[data-resolver]');
			const captures = [...document.querySelectorAll('[data-capture]')];
			const resolverRail = document.querySelector('[data-resolver-rail]');
			const resolverList = document.querySelector('[data-resolver-rail] .rail-list');

			if (resolver instanceof HTMLElement && resolverRail && resolverList && captures.length > 0) {
				const tabs: HTMLButtonElement[] = [];
				const show = (index: number, focusTab = false) => {
					captures.forEach((capture, i) => {
						capture.toggleAttribute('hidden', i !== index);
						capture.setAttribute('role', 'tabpanel');
						capture.setAttribute('tabindex', '0');
						capture.setAttribute('aria-labelledby', `resolver-tab-${i}`);
					});
					tabs.forEach((tab, i) => {
						tab.setAttribute('aria-selected', String(i === index));
						tab.setAttribute('tabindex', i === index ? '0' : '-1');
					});
					if (focusTab) tabs[index]?.focus();
				};

				captures.forEach((capture, index) => {
					const tab = document.createElement('button');
					tab.type = 'button';
					tab.setAttribute('role', 'tab');
					tab.id = `resolver-tab-${index}`;
					tab.setAttribute('aria-controls', capture.id);
					tab.textContent = capture.querySelector('h3')?.textContent?.replace(/[“”]/g, '') ?? '';
					tab.addEventListener('click', () => show(index, true));
					tab.addEventListener('keydown', (event) => {
						if (!(event instanceof KeyboardEvent) || !['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End'].includes(event.key)) return;
						event.preventDefault();
						const target =
							event.key === 'Home' ? 0
							: event.key === 'End' ? captures.length - 1
							: ['ArrowRight', 'ArrowDown'].includes(event.key) ? Math.min(captures.length - 1, index + 1)
							: Math.max(0, index - 1);
						show(target, true);
					});
					resolverList.append(tab);
					tabs.push(tab);
				});

				resolver.setAttribute('data-enhanced', 'true');
				resolverList.setAttribute('aria-orientation', 'vertical');
				resolverRail.toggleAttribute('hidden', false);
				show(0);
			}

			// The latch sequence: phases advance only through the explicit verbs.
			const latch = document.querySelector('[data-latch]');
			const latchStatus = document.querySelector('[data-latch-status]');
			const latchControls = [...document.querySelectorAll('[data-latch-control]')];
			const latchReset = document.querySelector('[data-latch-reset]');
			const reveal = document.querySelector('[data-capital-reveal]');
			const phaseTitles = [...document.querySelectorAll('[data-latch-phase] h3')].map((h) => h.textContent ?? '');
			const phaseNotes = [...document.querySelectorAll('[data-latch-phase] .phase-text p')].map((p) => p.textContent ?? '');

			if (
				latch instanceof HTMLElement &&
				latchStatus &&
				reveal instanceof HTMLElement &&
				latchReset instanceof HTMLButtonElement &&
				latchControls.length === 3
			) {
				const setPhase = (phase: number) => {
					latch.dataset.phase = String(phase);
					latchStatus.textContent = `${phaseTitles[phase] ?? ''} — ${phaseNotes[phase] ?? ''}`;
					latchControls.forEach((control) => {
						if (!(control instanceof HTMLButtonElement)) return;
						const index = Number(control.dataset.latchControl);
						control.disabled = index !== phase + 1;
					});
					reveal.toggleAttribute('data-revealed', phase === 3);
					latchReset.toggleAttribute('hidden', phase === 0);
				};

				latch.dataset.enhanced = 'true';
				reveal.setAttribute('data-gated', 'true');
				for (const control of latchControls) {
					control.addEventListener('click', () => {
						if (!(control instanceof HTMLButtonElement)) return;
						setPhase(Number(control.dataset.latchControl));
					});
				}
				latchReset.addEventListener('click', () => setPhase(0));
				setPhase(0);
			}

			// Calibration tags: one switch, plus the i key for inspectors.
			const calToggle = document.querySelector('[data-cal-toggle]');
			const calTags = [...document.querySelectorAll('[data-cal-tag]')];
			if (calToggle instanceof HTMLButtonElement) {
				const setCal = (on: boolean) => {
					document.body.classList.toggle('calibrating', on);
					calToggle.setAttribute('aria-pressed', String(on));
					for (const tag of calTags) tag.toggleAttribute('open', on);
				};
				calToggle.toggleAttribute('hidden', false);
				calToggle.addEventListener('click', () => setCal(!document.body.classList.contains('calibrating')));
				document.addEventListener('keydown', (event) => {
					if (!(event instanceof KeyboardEvent) || !event.altKey || event.code !== 'KeyI' || event.metaKey || event.ctrlKey) return;
					event.preventDefault();
					setCal(!document.body.classList.contains('calibrating'));
				});
			}
		</script>
	</body>
</html>
