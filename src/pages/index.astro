---
import CompactShift from '../components/CompactShift';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const createCommand = 'npx --yes @hairness/cli@latest create my-home';
---

<BaseLayout
	title="Hairness | A shared, owned way of working for humans and agents"
	description="Hairness is an open-source framework and CLI for source-owned, portable agent work environments across runtimes and repositories."
	path="/"
>
	<SiteHeader />
	<main>
		<section class="hero shell">
			<div class="hero-copy">
				<p class="eyebrow">A shared work system for humans and agents.</p>
				<h1>A shared, owned way of working for humans and agents.</h1>
				<p class="hero-lede">
					Hairness makes your agentic work environment explicit, owned and
					portable across Agent Runtimes, collaborators and repositories.
				</p>
				<p class="product-definition">
					An open-source framework and CLI that materializes a source-owned
					Home, connects independent Targets and projects supported surfaces
					into the Agent Runtimes you already use.
				</p>
				<div class="hero-actions">
					<a class="button button-primary" href="#create-home">Create your Home</a>
					<a class="button button-secondary" href="https://thevzion.com/home-first/">
						Read the Home-first Proposal <span aria-hidden="true">↗</span>
					</a>
				</div>
				<p class="proof-line">
					<span>Codex and Claude today</span>
					<span aria-hidden="true">·</span>
					<span>Hairness 0.5 alpha</span>
				</p>
			</div>

			<div class="hero-card" id="create-home">
				<div class="terminal-bar" aria-hidden="true">
					<span></span><span></span><span></span>
					<p>start with an owned source</p>
				</div>
				<div class="command-row">
					<code>{createCommand}</code>
					<button class="copy-button" type="button" data-copy={createCommand}>
						Copy
					</button>
				</div>
				<p>Creates an independent Home repository. Your Targets stay independent.</p>
			</div>
		</section>

		<section class="section shell shift-section">
			<div class="section-heading">
				<p class="eyebrow">The accidental environment</p>
				<h2>Your repository should own the product, not the whole agent environment.</h2>
				<p>
					Open an Agent Runtime inside a repository and that Target becomes the
					center of the setup. Methods, provider files, continuity and generated
					work collect beside product source.
				</p>
				<p>
					Hairness gives the portable environment its own source. Product-specific
					instructions remain with the Target. Shared methods and continuity
					remain in the Home.
				</p>
			</div>
			<CompactShift client:visible />
			<p class="runtime-note">
				<strong>Agent Runtime</strong> means the system that starts or hosts an
				agent session and exposes its tools. Hairness 0.5 currently calls its
				configured relation to that system a <strong>Provider</strong>. Model
				providers remain a separate layer.
			</p>
			<a class="text-link" href="https://thevzion.com/home-first/">
				Explore the full proposal on The VZion <span aria-hidden="true">↗</span>
			</a>
		</section>

		<section class="section product-map">
			<div class="shell">
				<div class="section-heading">
					<p class="eyebrow">Keep the tools. Own the environment.</p>
					<h2>The model can remain a black box. The Home does not have to be.</h2>
				</div>
				<div class="concept-map" role="table" aria-label="Hairness concepts and concrete expressions">
					<div class="concept-map-head" role="row">
						<strong role="columnheader">Need</strong>
						<strong role="columnheader">Hairness concept</strong>
						<strong role="columnheader">Concrete expression</strong>
					</div>
					<div role="row"><span role="cell">Shared orientation</span><strong role="cell">Home + Front Door</strong><code role="cell">HOME.md · Floor Plan</code></div>
					<div role="row"><span role="cell">Personal continuity</span><strong role="cell">Desk</strong><code role="cell">DESK.md · local Bindings</code></div>
					<div role="row"><span role="cell">Reusable capability</span><strong role="cell">Asset</strong><code role="cell">Skill or Command projection</code></div>
					<div role="row"><span role="cell">Chosen result</span><strong role="cell">Artifact</strong><code role="cell">Owner · state · lineage</code></div>
					<div role="row"><span role="cell">Product destination</span><strong role="cell">Target</strong><code role="cell">Independent repository</code></div>
					<div role="row"><span role="cell">Runtime compatibility</span><strong role="cell">Projection</strong><code role="cell">Codex or Claude form</code></div>
				</div>
				<div class="surface-line">
					<span>Human</span>
					<strong>Editor · Git · terminal</strong>
					<i aria-hidden="true">→</i>
					<b>Home</b>
					<i aria-hidden="true">←</i>
					<strong>Codex · Claude</strong>
					<span>Agent Runtime</span>
				</div>
				<p class="surface-note">
					Hairness does not require another desktop application and does not
					replace the Agent Runtime. Humans and agents use different surfaces
					over the same owned sources.
				</p>
			</div>
		</section>

		<section class="section section-dark product-truth">
			<div class="shell">
				<div class="section-heading">
					<p class="eyebrow eyebrow-light">Available today · 0.5 alpha</p>
					<h2>A real Home, not a diagram.</h2>
					<p>
						Create it, inspect it, version it and enter it through Codex or
						Claude. Hairness keeps owned sources separate from rebuildable
						runtime projections.
					</p>
				</div>
				<div class="truth-grid">
					<div><strong>Home</strong><span>Shared sources and orientation</span></div>
					<div><strong>Desk</strong><span>Collaborator-local continuity</span></div>
					<div><strong>Assets</strong><span>Reusable products for work</span></div>
					<div><strong>Artifacts</strong><span>Chosen results with lineage</span></div>
					<div><strong>Front Door</strong><span>Floor Plan and Home Console</span></div>
					<div><strong>Bindings</strong><span>Local relations to Targets</span></div>
					<div><strong>Projections</strong><span>Codex and Claude surfaces</span></div>
					<div><strong>Diagnostics</strong><span>Validation, build and doctor</span></div>
				</div>
				<a class="text-link text-link-light" href="https://github.com/thevzion/hairness">
					Inspect Hairness on GitHub <span aria-hidden="true">↗</span>
				</a>
			</div>
		</section>

		<section class="section shell direction-section">
			<div class="direction-column">
				<p class="eyebrow">Designed for</p>
				<h2>One working environment across runtimes and repositories.</h2>
				<ul class="direction-list">
					<li><strong>Provider-neutral sources</strong><span>Change the Agent Runtime without rebuilding the work environment.</span></li>
					<li><strong>Local working context</strong><span>Materialize owned context where the agent works before the work begins.</span></li>
					<li><strong>Human curation</strong><span>Turn reviewed results into better reusable Assets deliberately.</span></li>
				</ul>
			</div>
			<aside class="direction-note">
				<p>Direction, not an integration claim</p>
				<span>
					Codex and Claude are qualified today. Other runtimes, team Homes and
					published Home catalogs describe where Hairness is designed to go.
				</span>
			</aside>
		</section>

		<section class="section concept-section">
			<div class="shell">
				<div class="section-heading section-heading-wide">
					<p class="eyebrow">Conceptual · Not installable yet</p>
					<h2>Homes designed around real work.</h2>
					<p>
						A specialized Home could package a coherent collaboration system
						for a domain—not another folder of disconnected Skills.
					</p>
				</div>
				<div class="concept-grid">
					<article>
						<h3>Game Development Home</h3>
						<p>Design methods, engine conventions, playtest Artifacts and independent game Targets.</p>
					</article>
					<article>
						<h3>Designer Home</h3>
						<p>Research, critique practices, visual systems and durable decisions across client work.</p>
					</article>
					<article>
						<h3>Research Home</h3>
						<p>Evidence standards, reading methods, claims and governed outputs across changing tools.</p>
					</article>
				</div>
				<div class="center-action">
					<a class="button button-secondary" href="/homes/">Imagine your Home</a>
				</div>
			</div>
		</section>

		<section class="section shell alpha-section">
			<div class="alpha-card">
				<div>
					<p class="eyebrow">Hairness 0.5 alpha</p>
					<h2>Start with the agents and repositories you already use.</h2>
				</div>
				<div>
					<p>
						The CLI creates a dedicated Home, validates its contracts and
						projects supported Assets into Codex and Claude.
					</p>
					<div class="hero-actions">
						<a class="button button-primary" href="#create-home">Create your Home</a>
						<a class="text-link" href="https://github.com/thevzion/hairness">
							Inspect the source <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
	<SiteFooter />
</BaseLayout>

<script>
	const copyButton = document.querySelector<HTMLButtonElement>('[data-copy]');

	copyButton?.addEventListener('click', async () => {
		const command = copyButton.dataset.copy;
		if (!command || !navigator.clipboard) return;

		await navigator.clipboard.writeText(command);
		copyButton.textContent = 'Copied';
		window.setTimeout(() => {
			copyButton.textContent = 'Copy';
		}, 1600);
	});
</script>
