---
import BaseLayout from '../layouts/BaseLayout.astro';

const lanes = [
	{ signal: 'LIVE', status: 'Published', title: 'The 0.8 public baseline', items: ['File-based Homes, Rooms, Equipment, Sites and Routes', 'Deterministic Codex and Claude projections', 'Published package 0.8.0-alpha.1 remains the current registry observation'] },
	{ signal: 'ARMED', status: 'Qualified local candidate', title: 'The 0.10 Golden Workplace Slice', items: ['Native WORKPLACE.md, Member and Desk v9 declarations', 'Deterministic ResolvedWorkplace revisions and compact provider projections', 'Pathless Route v9 declarations with derived, Desk-scoped Checkout bindings', 'WORK.md v1alpha2 with typed Fragments and revision-bound completion', 'Endroit Profile 0.10 targeting open-workplace/0.2-draft', 'Not published or deployed until the release effects are separately authorized and observed'] },
	{ signal: 'PROBE', status: 'Next', title: 'Owner-correct migration and evidence', items: ['Migrate remaining Room, Site, Equipment and Artifact writers only with explicit owner-specific procedures', 'Qualify provider-hosted entry and resumption beyond static projection parity', 'Project source-pinned documentation without creating a second canon'] },
	{ signal: 'PARK', status: 'Excluded from this candidate', title: 'Autonomous infrastructure', items: ['No automatic transcript retention, inferred acceptance or delivery', 'No global project scan, daemon, graph database, persistent agent registry or required hosted service'] },
];
---

<BaseLayout title="Roadmap | Endroit" description="What Endroit makes available, is validating, is exploring and deliberately leaves for later." path="/roadmap/" current="roadmap">
	<main id="main" class="page-instrument">
		<section class="module page-hero" aria-labelledby="roadmap-title">
			<div>
				<p class="module-plate">SIGNAL BOARD · ROADMAP / 01</p>
				<h1 id="roadmap-title">Keep the place useful before making it alive.</h1>
				<p class="page-lede">A directional roadmap without dates. “Exploring” means evidence-seeking, not a delivery commitment. Release notes remain the source of truth for what shipped.</p>
			</div>
			<figure class="screen page-screen roadmap-screen">
				<div class="screen-face roadmap-traces" aria-hidden="true">{lanes.map((lane) => <p><span>{lane.signal}</span><i class={`roadmap-trace trace-${lane.signal.toLowerCase()}`}></i></p>)}</div>
				<figcaption>Four signal states. Only one means available now.</figcaption>
			</figure>
		</section>

		<section class="module" aria-labelledby="lanes-title">
			<p class="module-plate">MODULE · DELIVERY STATES</p>
			<h2 id="lanes-title">Read the status before the promise.</h2>
			<div class="roadmap-lanes">
				{lanes.map((lane, index) => (
					<article>
						<header><span class={`status-lamp lamp-${lane.signal.toLowerCase()}`}></span><p>{String(index + 1).padStart(2, '0')} · {lane.signal}</p><strong>{lane.status}</strong></header>
						<h3>{lane.title}</h3>
						<ul>{lane.items.map((item) => <li>{item}</li>)}</ul>
					</article>
				))}
			</div>
		</section>

		<section class="module page-terminal" aria-labelledby="roadmap-focus">
			<p class="module-plate">CURRENT TRIGGER</p>
			<h2 id="roadmap-focus">Publish the exact vertical slice. Learn from real Workplaces.</h2>
			<p class="module-lede">The candidate becomes available only when its package, schemas, documentation and deployed surfaces are observed from the same source commit.</p>
			<a class="action action-primary" href="https://github.com/thevzion/endroit/releases">Follow releases</a>
		</section>
	</main>
</BaseLayout>
